@using NED.WoT.BattleResults.Client.Theme
@inherits LayoutComponentBase

@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager
@inject SettingService SettingService
@inject UpdateCheckService UpdateCheckService

<MudThemeProvider Theme="WotTheme.Theme" IsDarkMode="true" ObserveSystemDarkModeChange="false" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Class="wot-appbar" Elevation="0">
        <span class="wot-rivet wot-rivet-tl"></span><span class="wot-rivet wot-rivet-tr"></span>
        <span class="wot-rivet wot-rivet-bl"></span><span class="wot-rivet wot-rivet-br"></span>
        <div class="wot-brand">
            <MudImage Src="img/gevechtslog-mark.svg" Alt="" Class="wot-brand-mark" />
            <span class="wot-wordmark">WoT <b>Gevechtslog</b></span>
        </div>
        @if (!string.IsNullOrEmpty(SettingService.Settings.ClanAbbreviation))
        {
            <span class="wot-vsep"></span>
            <MudChip T="string" Class="wot-clan-chip"><span class="wot-clan-tag">[@SettingService.Settings.ClanAbbreviation]</span></MudChip>
        }
        <MudSpacer />
        <FolderCarousel OnManage="() => OpenSettings(true)" />
        <MudSpacer />
        @if (UpdateCheckService.UpdateAvailable)
        {
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Update" OnClick="ShowUpdateDialog">Update</MudButton>
        }
        <MudTooltip Text="Vernieuwen">
            <MudIconButton Icon="@Icons.Material.Filled.Refresh" Color="Color.Inherit" aria-label="Vernieuwen" OnClick="Refresh" />
        </MudTooltip>
        <MudTooltip Text="Instellingen">
            <MudIconButton Icon="@Icons.Material.Filled.Settings" Color="Color.Inherit" aria-label="Instellingen" OnClick="(e) => OpenSettings(true)" />
        </MudTooltip>
    </MudAppBar>
    <MudMainContent>
        @Body
    </MudMainContent>
</MudLayout>

@code {
    protected override async Task OnInitializedAsync()
    {
        var first = SettingService.Settings.ReplayFolders.FirstOrDefault();
        if (first is null || !Directory.Exists(first.Path))
        {
            Snackbar.Add(BattleReportService.Notice("Replaymap", "de map is niet ingevuld of bestaat niet"), Severity.Warning);

            await Task.Delay(500);

            await OpenSettings(false);
        }

        UpdateCheckService.Start();
    }

    private void Refresh()
    {
        CustomAuthenticationStateProvider.ResetAuthenticationState();
        NavigationManager.NavigateTo(NavigationManager.Uri, forceLoad: true);
    }

    private async Task OpenSettings(bool canCancel = true)
    {
        IDialogReference dialog = await DialogService.ShowAsync<SettingsDialog>("Instellingen", new DialogParameters()
            {
                ["canCancel"] = canCancel
            }, new DialogOptions()
            {
                MaxWidth = MaxWidth.Medium,
                FullWidth = true,
                BackdropClick = false,
                CloseOnEscapeKey = canCancel,
                CloseButton = false
            });

        _ = RenderWhenClosedAsync(dialog);
    }

    /// <summary>The carousel shows the titles that were just saved. Not awaited by the callers: the first-run dialog must not hold up the start.</summary>
    private async Task RenderWhenClosedAsync(IDialogReference dialog)
    {
        await dialog.Result;
        await InvokeAsync(StateHasChanged);
    }

    private async Task ShowUpdateDialog()
    {
        await DialogService.ShowAsync<UpdateDialog>("Update", new DialogOptions()
            {
                MaxWidth = MaxWidth.Small,
                FullWidth = true,
                BackdropClick = false,
                CloseOnEscapeKey = true,
                CloseButton = false
            });
    }
}