@inject IdentityService Identity
@inject NavigationManager NavigationManager

@* Who you are signed in as (from HQ), and Uitloggen. Plain MudBlazor classes only: the menu renders in the popover provider, outside this component's scope. *@
@if (Identity.Current is { } who)
{
    <MudMenu Label="@who.Nickname" StartIcon="@Icons.Material.Filled.AccountCircle" Variant="Variant.Text" Color="Color.Inherit" AriaLabel="Account"
             AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
            <div class="pa-4" style="min-width: 260px;">
                <MudText Typo="Typo.h6">@who.Nickname</MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Ingelogd via Wargaming</MudText>
                <MudDivider Class="my-3" />
                <MudStack Spacing="2">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">Clan</MudText>
                        <MudText Typo="Typo.body2">@(who.ClanTag is null ? "Geen clan" : $"[{who.ClanTag}] {who.ClanName}")</MudText>
                    </MudStack>
                    @if (who.Role is not null)
                    {
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">Rol</MudText>
                            <MudChip T="string" Size="Size.Small">@RoleName(who.Role)</MudChip>
                        </MudStack>
                    }
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">Uitgebreide statistieken</MudText>
                        @if (who.CanSeeAdvancedStats)
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" Color="Color.Success" />
                        }
                        else
                        {
                            <MudText Typo="Typo.body2"><MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" /> Niet beschikbaar</MudText>
                        }
                    </MudStack>
                </MudStack>
            </div>
            <MudDivider />
            <MudMenuItem Icon="@Icons.Material.Filled.Logout" OnClick="SignOut">Uitloggen</MudMenuItem>
    </MudMenu>
}

@code {
    // Wargaming's spelling "combat_officer" -> WoT's English name "Combat Officer".
    private static string RoleName(string role) => string.Join(' ', role.Split('_').Select(w => char.ToUpperInvariant(w[0]) + w[1..]));

    // Forgets the token locally only (docs/PLAN.md §3.2); Routes shows the login.
    private void SignOut()
    {
        Identity.SignOut();
        NavigationManager.NavigateTo("login");
    }
}
