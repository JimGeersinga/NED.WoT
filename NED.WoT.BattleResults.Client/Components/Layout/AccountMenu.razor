@inject IdentityService Identity
@inject NavigationManager NavigationManager

@* Who you are signed in as (from HQ's answer), and Uitloggen. Same build as WoT HQ's UserMenu: a MudMenu whose activator toggles it explicitly. *@
@if (Identity.Current is { } who)
{
    <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" PopoverClass="wot-menu">
        <ActivatorContent Context="menu">
            <MudButton Variant="Variant.Text" Color="Color.Inherit" Class="wot-ubtn" aria-label="Account" OnClick="@menu.ToggleAsync">
                @if (who.Role != ClanRole.Unknown)
                {
                    <MudAvatar Class="wot-avatar"><img class="wot-rank-icon" src="img/ranks/@(who.Role).png" alt="" /></MudAvatar>
                }
                <span class="wot-ubtn-text">
                    <span class="wot-ubtn-name">@who.Nickname</span>
                    @if (who.Role != ClanRole.Unknown)
                    {
                        <span class="wot-ubtn-role">@who.Role.DisplayName()</span>
                    }
                </span>
                <MudIcon Icon="@Icons.Material.Outlined.ExpandMore" Class="wot-ubtn-chevron" />
            </MudButton>
        </ActivatorContent>
        <ChildContent>
            <div class="wot-menu-head">
                @if (who.Role != ClanRole.Unknown)
                {
                    <MudAvatar Class="wot-avatar wot-avatar-lg"><img class="wot-rank-icon" src="img/ranks/@(who.Role).png" alt="" /></MudAvatar>
                }
                <div class="wot-menu-head-text">
                    <span class="wot-ubtn-name">@who.Nickname</span>
                    <span class="wot-ubtn-role">
                        @if (who.Role != ClanRole.Unknown)
                        {
                            @who.Role.DisplayName()
                        }
                        @if (who.ClanTag is { Length: > 0 })
                        {
                            @if (who.Role != ClanRole.Unknown)
                            {
                                <span>&middot;</span>
                            }
                            @if (!string.IsNullOrEmpty(who.EmblemUrl))
                            {
                                <img class="wot-emblem" src="@who.EmblemUrl" alt="" />
                            }
                            <span>[@who.ClanTag]</span>
                        }
                    </span>
                </div>
            </div>
            <MudDivider />
            <div class="wot-menu-row">
                <span>Statistieken</span>
                @if (who.CanSeeAdvancedStats)
                {
                    <MudIcon Icon="@Icons.Material.Outlined.Check" Size="Size.Small" Color="Color.Success" />
                }
                else
                {
                    <b><MudIcon Icon="@Icons.Material.Outlined.Lock" Size="Size.Small" /> Niet beschikbaar</b>
                }
            </div>
            <MudDivider Class="mt-1" />
            <MudMenuItem Icon="@Icons.Material.Outlined.Logout" OnClick="SignOut">Uitloggen</MudMenuItem>
        </ChildContent>
    </MudMenu>
}

@code {
    // Forgets the token locally only (docs/PLAN.md section 3.2); Routes shows the login.
    private void SignOut()
    {
        Identity.SignOut();
        NavigationManager.NavigateTo("login");
    }
}
