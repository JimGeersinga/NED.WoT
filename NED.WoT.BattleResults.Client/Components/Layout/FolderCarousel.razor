@using System.Diagnostics
@implements IDisposable
@inject BattleReportService Reports
@inject SettingService SettingService

@* The replay folders in the app bar (design: "Component: app bar", "Replaymappen: navigatie"): arrows and the dimmed neighbours step through the folders and wrap around, the current title opens the folder menu. With one folder only that title is left. *@
@{
	List<ReplayFolder> folders = SettingService.Settings.ReplayFolders;
	int count = folders.Count;
	int current = Math.Clamp(Reports.CurrentFolder, 0, Math.Max(count - 1, 0));
}

@if (count > 0)
{
	ReplayFolder folder = folders[current];
	int previous = Wrap(current - 1, count);
	int next = Wrap(current + 1, count);
	<nav class="@("folder-carousel" + (count == 1 ? " folder-carousel-single" : string.Empty))" aria-label="Replaymappen">
		@if (count > 1)
		{
			<MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" Class="folder-carousel-arrow" aria-label="@($"Vorige map: {folders[previous].Title}")" title="Vorige map" OnClick="() => SelectAsync(previous)" />
			<MudButton Variant="Variant.Text" Class="folder-carousel-neighbour" tabindex="-1" aria-hidden="true" title="@folders[previous].Title" OnClick="() => SelectAsync(previous)">@folders[previous].Title</MudButton>
		}
		<MudMenu @ref="_menu" Open="_open" OpenChanged="OnOpenChanged" Class="folder-carousel-menu" PopoverClass="folder-menu-popover" AnchorOrigin="Origin.BottomCenter" TransformOrigin="Origin.TopCenter">
			<ActivatorContent>
				<MudButton Variant="Variant.Text" Class="folder-carousel-current" @ref="_title" OnClick="@context.ToggleAsync" aria-live="polite" title="@folder.Path">
					<span class="folder-carousel-title"><MudIcon Icon="@Icons.Material.Filled.FolderOpen" /><span class="folder-carousel-title-text">@folder.Title</span></span>
					@if (count > 1)
					{
						<span class="folder-carousel-dots" role="img" aria-label="@($"Map {current + 1} van {count}")">
							@for (int i = 0; i < count; i++)
							{
								<i class="@(i == current ? "folder-carousel-dot-current" : null)"></i>
							}
						</span>
					}
				</MudButton>
			</ActivatorContent>
			<ChildContent>
				@for (int i = 0; i < count; i++)
				{
					int index = i;
					ReplayFolder item = folders[i];
					int? battles = Reports.GetBattleCount(item);
					<MudMenuItem Icon="@Icons.Material.Filled.Check" IconColor="@(index == current ? Color.Primary : Color.Transparent)" role="menuitemradio" aria-checked="@(index == current ? "true" : "false")" OnClick="() => PickAsync(index)">
						<span class="folder-menu-item-text">
							<span class="folder-menu-item-title">@item.Title</span>
							<span class="folder-menu-item-path" title="@item.Path"><bdo dir="ltr">@item.Path</bdo></span>
						</span>
						@if (battles is not null)
						{
							<MudChip T="string" Size="Size.Small" Variant="Variant.Text" aria-label="@($"{battles} gevechten")">@battles</MudChip>
						}
					</MudMenuItem>
				}
				<MudDivider />
				<MudMenuItem Icon="@Icons.Material.Filled.Tune" OnClick="ManageAsync">Mappen beheren</MudMenuItem>
			</ChildContent>
		</MudMenu>
		@if (count > 1)
		{
			<MudButton Variant="Variant.Text" Class="folder-carousel-neighbour" tabindex="-1" aria-hidden="true" title="@folders[next].Title" OnClick="() => SelectAsync(next)">@folders[next].Title</MudButton>
			<MudIconButton Icon="@Icons.Material.Filled.ChevronRight" Class="folder-carousel-arrow" aria-label="@($"Volgende map: {folders[next].Title}")" title="Volgende map" OnClick="() => SelectAsync(next)" />
		}
	</nav>
}

@code {
	/// <summary>The settings dialog opened from the menu ("Mappen beheren").</summary>
	[Parameter]
	public EventCallback OnManage { get; set; }

	private bool _open;
	private MudMenu? _menu;
	private bool _managing;
	private MudButton? _title;

	protected override void OnInitialized()
	{
		Debug.Assert(Wrap(3, 3) == 0 && Wrap(-1, 3) == 2 && Wrap(1, 3) == 1 && Wrap(0, 1) == 0, "the carousel wraps: after the last comes the first, before the first comes the last");

		Reports.FolderChanged += OnFolderChanged;
		Reports.LoadingBattleReportsFinished += OnFolderChanged;
	}

	public void Dispose()
	{
		Reports.FolderChanged -= OnFolderChanged;
		Reports.LoadingBattleReportsFinished -= OnFolderChanged;
	}

	/// <summary>A folder was selected, or a load finished (the menu then has a count to show).</summary>
	private void OnFolderChanged(object? sender, EventArgs e) => _ = InvokeAsync(StateHasChanged);

	/// <summary>The position after stepping from <paramref name="index"/>: past the last folder is the first, before the first is the last.</summary>
	private static int Wrap(int index, int count) => ((index % count) + count) % count;

	private Task SelectAsync(int index) => Reports.SelectFolderAsync(index);

	/// <summary>MudMenu closes on Escape and after a pick but leaves the focus on the page: it returns to the current title (not for "Mappen beheren": the dialog takes it).</summary>
	private async Task OnOpenChanged(bool open)
	{
		_open = open;
		bool managing = _managing;
		_managing = false;
		if (!open && !managing)
		{
			await _title!.FocusAsync();
		}
	}

	/// <summary>MudMenuItem awaits OnClick before it closes the menu: close first, so the menu does not wait for the folder to load.</summary>
	private async Task PickAsync(int index)
	{
		await _menu!.CloseMenuAsync();
		await SelectAsync(index);
	}

	private Task ManageAsync()
	{
		_managing = true;
		return OnManage.InvokeAsync();
	}
}
