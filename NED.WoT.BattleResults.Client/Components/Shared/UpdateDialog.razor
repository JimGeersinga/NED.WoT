@using System.Diagnostics

<MudDialog Class="wot-dialog" TitleClass="wot-dialog-bar">
    <TitleContent>
        <WotDialogTitle Dialog="MudDialog" Icon="@Icons.Material.Outlined.Update" Title="Update" />
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="1">
            <MudText Typo="Typo.body1">Er is een nieuwe versie van de applicatie beschikbaar.</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">Herstarten sluit Gevechtslog en opent daarna de nieuwe versie.</MudText>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Negeren</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Restart">Herstarten</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    public required IMudDialogInstance MudDialog { get; set; }

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    private void Restart()
    {
        string? exePath = Process.GetCurrentProcess().MainModule?.FileName;

        Process.Start(new ProcessStartInfo
            {
                FileName = exePath,
                UseShellExecute = true,
                WorkingDirectory = Environment.CurrentDirectory
            });

        Application.Current?.Quit();
    }
}
