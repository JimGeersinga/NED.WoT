@using IndexPage = NED.WoT.BattleResults.Client.Components.Pages.Index

@inject IDialogService DialogService

@* The filter bar over the battle table: the Clan and Speler dropdowns (MudAutocomplete over BattleFilters, styled by wot-filter in mud.css), the match type and result chips (#14 replaces those) and the tool buttons. Index owns the state and gets it back through the callbacks. *@
@{
	var clanMembers = Filtered.SelectMany(x => x.Team1.Players.Concat(x.Team2.Players)).Where(x => x.IsClanMember).Select(x => x.Name).Distinct().Count();
	var undefinedNames = TankNameResolver.UndefinedTankNames.Count + MapNameResolver.UndefinedMapNames.Count;
}

<section class="gl-bar" aria-label="Filters">
	<MudAutocomplete T="BattleFilters.Option" Placeholder="Clan kiezen" aria-label="Clan"
					 Value="_clan" ValueChanged="PickClan"
					 SearchFunc="SearchClans" ToStringFunc="@(o => o?.Name)" ItemDisabledFunc="@(o => o.Header != null)"
					 MaxItems="MaxItems" ReturnedItemsCountChanged="@(n => _clanCount = n)"
					 Variant="Variant.Filled" Margin="Margin.Dense" Class="@("wot-filter" + (Clan != null ? " filled" : string.Empty))" PopoverClass="wot-filter-pop"
					 Adornment="Adornment.Start" AdornmentIcon="@BattleFilters.Shield" Strict="false" OpenOnFocus="true"
					 Clearable="true" ResetValueOnEmptyText="true" CoerceText="true" DebounceInterval="150" RelativeWidth="DropdownWidth.Adaptive">
		<ItemTemplate Context="o">
			<span class="wot-opt"><span class="wot-opt-tag">[@BattleFilters.Highlighted(o.Name, _clanTerm)]</span><span class="wot-opt-n wot-num">@BattleCount(o.Battles)</span></span>
		</ItemTemplate>
		<ItemDisabledTemplate Context="o"><span class="wot-opt-h">@o.Header</span></ItemDisabledTemplate>
		<MoreItemsTemplate><span class="wot-opt-more">Nog @(_clanCount - MaxItems) clans · typ om te zoeken</span></MoreItemsTemplate>
		<NoItemsTemplate><span class="wot-opt-more">Geen clan gevonden</span></NoItemsTemplate>
	</MudAutocomplete>

	<MudAutocomplete T="BattleFilters.Option" Placeholder="Speler zoeken" aria-label="Speler"
					 Value="_player" ValueChanged="PickPlayer"
					 SearchFunc="SearchPlayers" ToStringFunc="@(o => o?.Name)" ItemDisabledFunc="@(o => o.Header != null)"
					 MaxItems="@(Clan == null ? MaxItems : (int?)null)" ReturnedItemsCountChanged="@(n => _playerCount = n)"
					 Variant="Variant.Filled" Margin="Margin.Dense" Class="@("wot-filter" + (Player != null ? " filled" : string.Empty))" PopoverClass="wot-filter-pop"
					 Adornment="Adornment.Start" AdornmentIcon="@BattleFilters.Helmet" AdornmentText="@PlayerTag" Strict="false" OpenOnFocus="true"
					 Clearable="true" ResetValueOnEmptyText="true" CoerceText="true" DebounceInterval="150" RelativeWidth="DropdownWidth.Adaptive">
		<ItemTemplate Context="o">
			<span class="wot-opt">
				@if (Clan == null)
				{
					<span class="wot-opt-tag">[@(o.Clan ?? "?")]</span>
				}
				<span>@BattleFilters.Highlighted(o.Name, _playerTerm)</span>
				@if (Clan != null)
				{
					<span class="wot-opt-n wot-num">@BattleCount(o.Battles)</span>
				}
			</span>
		</ItemTemplate>
		<ItemDisabledTemplate Context="o"><span class="wot-opt-h">@o.Header</span></ItemDisabledTemplate>
		<MoreItemsTemplate><span class="wot-opt-more">Nog @(_playerCount - MaxItems) spelers · typ om te zoeken</span></MoreItemsTemplate>
		<NoItemsTemplate><span class="wot-opt-more">Geen speler gevonden</span></NoItemsTemplate>
	</MudAutocomplete>

	<MudToggleGroup T="IndexPage.MatchType" Value="MatchType" ValueChanged="MatchTypeChanged" Class="wot-view-toggle" aria-label="Soort gevechten">
		@foreach (var matchType in Enum.GetValues<IndexPage.MatchType>())
		{
			<MudToggleItem Value="matchType" Text="@matchType.ToString()" />
		}
	</MudToggleGroup>

	<div class="gl-chips" role="group" aria-label="Resultaat">
		@foreach (var result in ResultVisibility.Keys)
		{
			var shown = ResultVisibility[result];
			<MudChip T="string" Class="wot-filter-chip" Selected="@shown" OnClick="() => OnToggleResult.InvokeAsync(result)" aria-pressed="@(shown ? "true" : "false")">
				@ResultChip.Word(result)<span class="wot-num ml-1">@Filtered.Count(x => x.Result == result)</span>
			</MudChip>
		}
	</div>

	<div class="gl-tools">
		@if (CanToggleBattleStats)
		{
			<button type="button" class="gl-imgbtn gl-icon-only gl-book" aria-pressed="@(ShowBattleStats ? "true" : "false")" aria-label="Statistieken" title="Uitgebreide statistieken&#10;▲ hoog · ▬ gemiddeld · ▼ laag&#10;Geraakt: ≤ 50% laag, ≥ 70% hoog&#10;Gepenetreerd: ≤ 55% laag, ≥ 70% hoog&#10;Geblokt: ≥ 25% hoog" @onclick="() => ShowBattleStatsChanged.InvokeAsync(!ShowBattleStats)">
				<img src="@(ShowBattleStats ? "images/book-open.png" : "images/book-closed.png")" alt="" />
			</button>
		}

		<button type="button" class="gl-imgbtn gl-icon-only" aria-label="Clanleden, @clanMembers" title="Clanleden" @onclick="OpenClanMembersDialog">
			<img src="images/crew.png" alt="" /><span class="gl-badge">@clanMembers</span>
		</button>

		@if (undefinedNames > 0)
		{
			<button type="button" class="gl-imgbtn gl-icon-only gl-warn" aria-label="@undefinedNames onbekende mapnamen en tanknamen" title="Onbekende mapnamen en tanknamen" @onclick="OpenUndefinedNamesDialog">
				<img src="images/CrewSkill_Commander_sixthSense.png" alt="" /><span class="gl-badge">@undefinedNames</span>
			</button>
		}
	</div>
</section>

@code {
	/// <summary>The lookup of the clans and players in the battles, built once by Index and dropped when the battles change.</summary>
	[Parameter, EditorRequired]
	public required BattleFilters Filters { get; set; }

	/// <summary>The battles that pass the filters and the match type: the result counts and the clan member count follow these.</summary>
	[Parameter, EditorRequired]
	public required IReadOnlyCollection<BattleReport> Filtered { get; set; }

	/// <summary>The chosen clan tag; null shows every clan.</summary>
	[Parameter]
	public string? Clan { get; set; }

	[Parameter]
	public EventCallback<string?> ClanChanged { get; set; }

	/// <summary>The chosen player name; null shows every player.</summary>
	[Parameter]
	public string? Player { get; set; }

	[Parameter]
	public EventCallback<string?> PlayerChanged { get; set; }

	[Parameter]
	public IndexPage.MatchType MatchType { get; set; }

	[Parameter]
	public EventCallback<IndexPage.MatchType> MatchTypeChanged { get; set; }

	[Parameter, EditorRequired]
	public required IReadOnlyDictionary<Result, bool> ResultVisibility { get; set; }

	[Parameter]
	public EventCallback<Result> OnToggleResult { get; set; }

	[Parameter]
	public bool CanToggleBattleStats { get; set; }

	[Parameter]
	public bool ShowBattleStats { get; set; }

	[Parameter]
	public EventCallback<bool> ShowBattleStatsChanged { get; set; }

	/// <summary>A dropdown shows this many lines (headers included); the rest is found by typing. MudAutocomplete does not virtualize. The Speler list of a chosen clan is not capped: a clan has far fewer players than the whole log.</summary>
	private const int MaxItems = 100;

	private BattleFilters.Option? _clan;
	private BattleFilters.Option? _player;
	private string _clanTerm = string.Empty;
	private string _playerTerm = string.Empty;
	private int _clanCount;
	private int _playerCount;

	protected override void OnParametersSet()
	{
		// The chosen values live in Index as plain strings (and are cleared there by "Filters wissen"): the boxes follow them.
		_clan = Clan == null ? null : _clan?.Name == Clan ? _clan : new BattleFilters.Option(Clan, Clan, 0);
		_player = Player == null ? null : _player?.Name == Player ? _player : new BattleFilters.Option(Player, null, 0);
	}

	private static string BattleCount(int battles) => $"{battles} {(battles == 1 ? "gevecht" : "gevechten")}";

	/// <summary>The clan tag of the picked player as the start adornment of the Speler box (mud.css colours it and draws the helmet in front); the helmet icon shows while no tag is set.</summary>
	private string? PlayerTag => _player?.Clan is { Length: > 0 } clan ? $"[{clan}]" : null;

	private Task<IEnumerable<BattleFilters.Option>> SearchClans(string? term, CancellationToken token)
	{
		_clanTerm = term ?? string.Empty;
		return Task.Run(() => Filters.ClanOptions(term), token);
	}

	private Task<IEnumerable<BattleFilters.Option>> SearchPlayers(string? term, CancellationToken token)
	{
		_playerTerm = term ?? string.Empty;
		return Task.Run(() => Filters.PlayerOptions(Clan, term), token);
	}

	/// <summary>Choosing a clan drops a chosen player who never played for it, so the two filters do not leave an empty table by themselves.</summary>
	private async Task PickClan(BattleFilters.Option? clan)
	{
		_clan = clan;
		await ClanChanged.InvokeAsync(clan?.Name);

		if (clan != null && Player != null && Filters.PlayerAfterClan(Player, clan.Name) == null)
		{
			await PlayerChanged.InvokeAsync(null);
		}
	}

	private Task PickPlayer(BattleFilters.Option? player)
	{
		_player = player;
		return PlayerChanged.InvokeAsync(player?.Name);
	}

	private async Task OpenUndefinedNamesDialog()
	{
		await DialogService.ShowAsync<UndefinedNamesDialog>("Onbekende namen", new DialogOptions
		{
			CloseOnEscapeKey = true
		});
	}

	private async Task OpenClanMembersDialog()
	{
		await DialogService.ShowAsync<ClanMembersDialog>("Clan leden",
			new DialogParameters<ClanMembersDialog>() { { x => x.Reports, Filtered } },
			new DialogOptions
			{
				CloseOnEscapeKey = true,
				FullWidth = true,
				MaxWidth = MaxWidth.Small
			});
	}
}
