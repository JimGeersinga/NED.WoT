@inject IDialogService DialogService

@* The filter bar over the battle table, in the order of the design: the Clangevechten | Alles switch, a separator, then the Clan and Speler dropdowns (MudAutocomplete over BattleFilters, styled by wot-filter in mud.css), the Map and Resultaat dropdowns and the tool buttons. Index owns the state and gets it back through the callbacks. *@
@{
	var clanMembers = Filtered.SelectMany(x => x.Team1.Players.Concat(x.Team2.Players)).Where(x => x.IsClanMember).Select(x => x.Name).Distinct().Count();
	var undefinedNames = TankNameResolver.UndefinedTankNames.Count + MapNameResolver.UndefinedMapNames.Count;
}

<section class="gl-bar" aria-label="Filters">
	<MudToggleGroup T="bool" Value="ClanOnly" ValueChanged="ClanOnlyChanged" Class="wot-view-toggle" aria-label="Soort gevechten">
		<MudToggleItem Value="true" Text="Clangevechten" />
		<MudToggleItem Value="false" Text="Alles" />
	</MudToggleGroup>

	<span class="wot-vsep" role="separator" aria-orientation="vertical"></span>

	<MudAutocomplete T="BattleFilters.Option" Placeholder="Clan kiezen" aria-label="Clan"
					 Value="_clan" ValueChanged="PickClan"
					 SearchFunc="SearchClans" ToStringFunc="@(o => o?.Name)" ItemDisabledFunc="@(o => o.Header != null)"
					 MaxItems="MaxItems" ReturnedItemsCountChanged="@(n => _clanCount = n)"
					 Variant="Variant.Filled" Margin="Margin.Dense" Class="@("wot-filter" + (Clan != null ? " filled" : string.Empty))" PopoverClass="wot-filter-pop"
					 Adornment="Adornment.Start" AdornmentIcon="@BattleFilters.Shield" Strict="false" OpenOnFocus="true"
					 Clearable="true" ResetValueOnEmptyText="true" CoerceText="true" DebounceInterval="150" RelativeWidth="DropdownWidth.Adaptive">
		<ItemTemplate Context="o">
			<span class="wot-opt"><span class="wot-opt-tag">[@BattleFilters.Highlighted(o.Name, _clanTerm)]</span><span class="wot-opt-n wot-num">@BattleCount(o.Battles)</span></span>
		</ItemTemplate>
		<ItemDisabledTemplate Context="o"><span class="wot-opt-h">@o.Header</span></ItemDisabledTemplate>
		<MoreItemsTemplate><span class="wot-opt-more">Nog @(_clanCount - MaxItems) clans · typ om te zoeken</span></MoreItemsTemplate>
		<NoItemsTemplate><span class="wot-opt-more">Geen clan gevonden</span></NoItemsTemplate>
	</MudAutocomplete>

	<MudAutocomplete T="BattleFilters.Option" Placeholder="Speler zoeken" aria-label="Speler"
					 Value="_player" ValueChanged="PickPlayer"
					 SearchFunc="SearchPlayers" ToStringFunc="@(o => o?.Name)" ItemDisabledFunc="@(o => o.Header != null)"
					 MaxItems="@(Clan == null ? MaxItems : (int?)null)" ReturnedItemsCountChanged="@(n => _playerCount = n)"
					 Variant="Variant.Filled" Margin="Margin.Dense" Class="@("wot-filter" + (Player != null ? " filled" : string.Empty))" PopoverClass="wot-filter-pop"
					 Adornment="Adornment.Start" AdornmentIcon="@BattleFilters.Helmet" AdornmentText="@PlayerTag" Strict="false" OpenOnFocus="true"
					 Clearable="true" ResetValueOnEmptyText="true" CoerceText="true" DebounceInterval="150" RelativeWidth="DropdownWidth.Adaptive">
		<ItemTemplate Context="o">
			<span class="wot-opt">
				@if (Clan == null)
				{
					<span class="wot-opt-tag">[@(o.Clan ?? "?")]</span>
				}
				<span>@BattleFilters.Highlighted(o.Name, _playerTerm)</span>
				@if (Clan != null)
				{
					<span class="wot-opt-n wot-num">@BattleCount(o.Battles)</span>
				}
			</span>
		</ItemTemplate>
		<ItemDisabledTemplate Context="o"><span class="wot-opt-h">@o.Header</span></ItemDisabledTemplate>
		<MoreItemsTemplate><span class="wot-opt-more">Nog @(_playerCount - MaxItems) spelers · typ om te zoeken</span></MoreItemsTemplate>
		<NoItemsTemplate><span class="wot-opt-more">Geen speler gevonden</span></NoItemsTemplate>
	</MudAutocomplete>

	@* Map: a MudMenu whose popover holds a search box, a checkbox per map and the Wissen and Alles buttons; the field is its activator. *@
	<MudMenu @bind-Open="_mapOpen" Class="wot-pick" PopoverClass="wot-filter-pop wot-map-pop" RelativeWidth="DropdownWidth.Adaptive" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft">
		<ActivatorContent>
			@* The clear button is MudBlazor's own (a small MudIconButton with its mud-input-clear-button class), placed over the box like the one MudBlazor draws in the other three; it sits outside the clickable field so its click does not also toggle the menu. *@
			<div class="wot-pick-field">
				<div @onclick="() => ToggleMap(context)">
					<MudTextField T="string" ReadOnly="true" Text="@BattleFilters.MapSummary(Maps)" Placeholder="Alle maps" aria-label="Map" aria-haspopup="listbox"
								  Variant="Variant.Filled" Margin="Margin.Dense" Class="@("wot-filter" + (Maps.Count > 0 ? " filled" : string.Empty))"
								  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Map" />
				</div>
				@if (Maps.Count > 0)
				{
					<MudIconButton Icon="@Icons.Material.Filled.Clear" Size="Size.Small" Class="mud-input-clear-button wot-pick-clear" aria-label="Maps wissen" title="Maps wissen" OnClick="ClearMaps" />
				}
			</div>
		</ActivatorContent>
		<ChildContent>
			@if (_mapOpen)
			{
				var maps = BattleFilters.MapOptions(Scoped, Maps, _mapTerm);
				<div class="wot-map-search" @onkeydown="MapKey">
					<MudTextField T="string" @bind-Value="_mapTerm" Immediate="true" Placeholder="Zoek een map" aria-label="Map zoeken"
								  Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Search" />
				</div>
				<div class="wot-map-list" role="listbox" aria-multiselectable="true" aria-label="Maps">
					@foreach (var map in maps)
					{
						var name = map.Name;
						<div role="option" aria-selected="@(Maps.Contains(name) ? "true" : "false")">
							<MudCheckBox T="bool" Value="Maps.Contains(name)" ValueChanged="@(on => ToggleMapName(name, on))" Dense="true" Color="Color.Primary">
								<span class="wot-opt"><span>@BattleFilters.Highlighted(name, _mapTerm)</span><span class="wot-opt-n wot-num">@BattleCount(map.Battles)</span></span>
							</MudCheckBox>
						</div>
					}
					@if (maps.Count == 0)
					{
						<span class="wot-opt-more wot-map-none">Geen map gevonden</span>
					}
				</div>
				<div class="wot-map-foot">
					<span class="wot-opt-more wot-num">@Maps.Count geselecteerd</span>
					<MudButton Variant="Variant.Text" Size="Size.Small" Disabled="@(Maps.Count == 0)" OnClick="ClearMaps">Wissen</MudButton>
					<MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="() => TickAll(maps)">Alles</MudButton>
				</div>
			}
		</ChildContent>
	</MudMenu>

	@* Resultaat: a multi-select; nothing ticked shows every result. *@
	<MudSelect T="Result" MultiSelection="true" SelectedValues="Results" SelectedValuesChanged="PickResults" ToStringFunc="ResultChip.Word" MultiSelectionTextFunc="ResultText"
			   Placeholder="Alle resultaten" aria-label="Resultaat" Variant="Variant.Filled" Margin="Margin.Dense" Class="@("wot-filter wot-result" + (Results.Count > 0 ? " filled" : string.Empty))" PopoverClass="wot-filter-pop wot-result-pop"
			   Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.EmojiEvents" Clearable="@(Results.Count > 0)" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft">
		@foreach (var result in ResultChip.Order)
		{
			<MudSelectItem T="Result" Value="result">
				<span class="wot-opt"><ResultChip Result="result" /><span class="wot-opt-n wot-num">@Filtered.Count(x => x.Result == result)</span></span>
			</MudSelectItem>
		}
	</MudSelect>

	<div class="gl-tools">
		@if (CanToggleBattleStats)
		{
			<button type="button" class="gl-imgbtn gl-icon-only gl-book" aria-pressed="@(ShowBattleStats ? "true" : "false")" aria-label="Statistieken" title="Uitgebreide statistieken&#10;▲ hoog · ▬ gemiddeld · ▼ laag&#10;Geraakt: ≤ 50% laag, ≥ 70% hoog&#10;Gepenetreerd: ≤ 55% laag, ≥ 70% hoog&#10;Geblokt: ≥ 25% hoog" @onclick="() => ShowBattleStatsChanged.InvokeAsync(!ShowBattleStats)">
				<img src="@(ShowBattleStats ? "images/book-open.png" : "images/book-closed.png")" alt="" />
			</button>
		}

		<button type="button" class="gl-imgbtn gl-icon-only" aria-label="Clanleden, @clanMembers" title="Clanleden" @onclick="OpenClanMembersDialog">
			<img src="images/crew.png" alt="" /><span class="gl-badge">@clanMembers</span>
		</button>

		@if (undefinedNames > 0)
		{
			<button type="button" class="gl-imgbtn gl-icon-only gl-warn" aria-label="@undefinedNames onbekende mapnamen en tanknamen" title="Onbekende mapnamen en tanknamen" @onclick="OpenUndefinedNamesDialog">
				<img src="images/CrewSkill_Commander_sixthSense.png" alt="" /><span class="gl-badge">@undefinedNames</span>
			</button>
		}
	</div>
</section>

@code {
	/// <summary>The lookup of the clans and players in the battles, built once by Index and dropped when the battles change.</summary>
	[Parameter, EditorRequired]
	public required BattleFilters Filters { get; set; }

	/// <summary>The battles that pass the filters and the match type: the result counts and the clan member count follow these.</summary>
	[Parameter, EditorRequired]
	public required IReadOnlyCollection<BattleReport> Filtered { get; set; }

	/// <summary>The chosen clan tag; null shows every clan.</summary>
	[Parameter]
	public string? Clan { get; set; }

	[Parameter]
	public EventCallback<string?> ClanChanged { get; set; }

	/// <summary>The chosen player name; null shows every player.</summary>
	[Parameter]
	public string? Player { get; set; }

	[Parameter]
	public EventCallback<string?> PlayerChanged { get; set; }

	/// <summary>The battles that pass the switch, the clan and the player but not the Map filter: the Map list counts these, so each map shows what ticking it would give.</summary>
	[Parameter, EditorRequired]
	public required IReadOnlyCollection<BattleReport> Scoped { get; set; }

	/// <summary>Clangevechten (true) hides the random battles, Alles (false) shows them too.</summary>
	[Parameter]
	public bool ClanOnly { get; set; }

	[Parameter]
	public EventCallback<bool> ClanOnlyChanged { get; set; }

	/// <summary>The ticked maps; empty shows every map.</summary>
	[Parameter, EditorRequired]
	public required HashSet<string> Maps { get; set; }

	[Parameter]
	public EventCallback<HashSet<string>> MapsChanged { get; set; }

	/// <summary>The ticked results; empty shows every result.</summary>
	[Parameter, EditorRequired]
	public required HashSet<Result> Results { get; set; }

	[Parameter]
	public EventCallback<HashSet<Result>> ResultsChanged { get; set; }

	[Parameter]
	public bool CanToggleBattleStats { get; set; }

	[Parameter]
	public bool ShowBattleStats { get; set; }

	[Parameter]
	public EventCallback<bool> ShowBattleStatsChanged { get; set; }

	/// <summary>A dropdown shows this many lines (headers included); the rest is found by typing. MudAutocomplete does not virtualize. The Speler list of a chosen clan is not capped: a clan has far fewer players than the whole log.</summary>
	private const int MaxItems = 100;

	private BattleFilters.Option? _clan;
	private BattleFilters.Option? _player;
	private string _clanTerm = string.Empty;
	private string _playerTerm = string.Empty;
	private int _clanCount;
	private int _playerCount;
	private bool _mapOpen;
	private string? _mapTerm;


	protected override void OnParametersSet()
	{
		// The chosen values live in Index as plain strings (and are cleared there by "Filters wissen"): the boxes follow them.
		_clan = Clan == null ? null : _clan?.Name == Clan ? _clan : new BattleFilters.Option(Clan, Clan, 0);
		_player = Player == null ? null : _player?.Name == Player ? _player : new BattleFilters.Option(Player, null, 0);
	}

	private static string BattleCount(int battles) => $"{battles} {(battles == 1 ? "gevecht" : "gevechten")}";

	/// <summary>The clan tag as the start adornment of the Speler box (mud.css colours it and draws the helmet in front of it); with no tag the helmet icon shows.</summary>
	private string? PlayerTag => BattleFilters.SpelerTag(Clan, _player) is { } tag ? $"[{tag}]" : null;

	private Task<IEnumerable<BattleFilters.Option>> SearchClans(string? term, CancellationToken token)
	{
		_clanTerm = term ?? string.Empty;
		return Task.Run(() => Filters.ClanOptions(term), token);
	}

	private Task<IEnumerable<BattleFilters.Option>> SearchPlayers(string? term, CancellationToken token)
	{
		_playerTerm = term ?? string.Empty;
		return Task.Run(() => Filters.PlayerOptions(Clan, term), token);
	}

	/// <summary>Choosing a clan drops a chosen player who never played for it, so the two filters do not leave an empty table by themselves.</summary>
	private async Task PickClan(BattleFilters.Option? clan)
	{
		_clan = clan;
		await ClanChanged.InvokeAsync(clan?.Name);

		if (clan != null && Player != null && Filters.PlayerAfterClan(Player, clan.Name) == null)
		{
			await PlayerChanged.InvokeAsync(null);
		}
	}

	private Task PickPlayer(BattleFilters.Option? player)
	{
		_player = player;
		return PlayerChanged.InvokeAsync(player?.Name);
	}

	private async Task OpenUndefinedNamesDialog()
	{
		await DialogService.ShowAsync<UndefinedNamesDialog>("Onbekende namen", new DialogOptions
		{
			CloseOnEscapeKey = true
		});
	}

	private async Task OpenClanMembersDialog()
	{
		await DialogService.ShowAsync<ClanMembersDialog>("Clan leden",
			new DialogParameters<ClanMembersDialog>() { { x => x.Reports, Filtered } },
			new DialogOptions
			{
				CloseOnEscapeKey = true,
				FullWidth = true,
				MaxWidth = MaxWidth.Small
			});
	}

	private async Task ToggleMap(MenuContext menu)
	{
		_mapTerm = null;
		await menu.ToggleAsync();
	}

	/// <summary>Escape in the search box closes the list (MudMenu only hears it on the list itself).</summary>
	private void MapKey(KeyboardEventArgs e)
	{
		if (e.Key == "Escape")
		{
			_mapOpen = false;
		}
	}

	private Task ClearMaps() => MapsChanged.InvokeAsync([]);

	private Task ToggleMapName(string name, bool on)
	{
		HashSet<string> maps = [.. Maps];
		if (on)
		{
			maps.Add(name);
		}
		else
		{
			maps.Remove(name);
		}

		return MapsChanged.InvokeAsync(maps);
	}

	/// <summary>Alles ticks every map in the list as it is now (the typed term narrows it).</summary>
	private Task TickAll(IEnumerable<BattleFilters.Option> listed) => MapsChanged.InvokeAsync([.. Maps, .. listed.Select(x => x.Name)]);

	private Task PickResults(IEnumerable<Result>? results) => ResultsChanged.InvokeAsync([.. results ?? []]);

	/// <summary>The box text: the first ticked result in the order of the list and "+n" for the rest.</summary>
	private static string ResultText(IReadOnlyList<string> words)
	{
		List<string> sorted = [.. words.OrderBy(w => Array.FindIndex(ResultChip.Order, r => ResultChip.Word(r) == w))];
		return sorted.Count == 0 ? string.Empty : sorted.Count == 1 ? sorted[0] : $"{sorted[0]} +{sorted.Count - 1}";
	}
}
