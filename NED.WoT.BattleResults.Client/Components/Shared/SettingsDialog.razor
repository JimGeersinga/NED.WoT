@using System.ComponentModel.DataAnnotations;
@using NED.WoT.BattleResults.Client.Attributes;

@using Windows.Management.Deployment
@inject ISnackbar Snackbar
@inject SettingService SettingService
@inject BattleReportService BattleReportService
@inject NavigationManager NavigationManager

<EditForm EditContext="_editContext" OnSubmit="OnSubmit" class="d-flex flex-column overflow-hidden">
    <DataAnnotationsValidator />
    <MudDialog Class="wot-dialog overflow-hidden" ContentClass="overflow-y-auto" TitleClass="wot-dialog-bar" Style="max-width: 760px">
        <TitleContent>
            <WotDialogTitle Dialog="MudDialog" Icon="@Icons.Material.Outlined.Settings" Title="Instellingen" Closable="CanCancel" />
        </TitleContent>
        <DialogContent>
            <MudStack Spacing="3" Class="pt-2">
                <MudStack Row Spacing="3" AlignItems="AlignItems.Baseline">
                    <MudText Typo="Typo.overline" Color="Color.Tertiary">Replaymappen</MudText>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">De volgorde hier is de volgorde van de navigatie in de app bar.</MudText>
                </MudStack>
                <MudDropContainer T="ReplayFolder" @ref="_container" Items="modal.ReplayFolders" ItemsSelector="@((folder, zone) => true)"
                                  ItemDropped="OnFolderDropped" ItemDraggingClass="drag">
                    <ChildContent>
                        <MudDropZone T="ReplayFolder" Identifier="folders" AllowReorder Class="d-flex flex-column gap-2" />
                    </ChildContent>
                    <ItemRenderer Context="folder">
                        @{
                            int index = modal.ReplayFolders.IndexOf(folder);
                            string name = string.IsNullOrWhiteSpace(folder.Title) ? "nieuwe map" : folder.Title;

                            // The orange drop line: while a row is dragged, a line shows where it will land (after the row the target index
                            // points at when it moves down, before it when it moves up).
                            bool dragging = _container?.TransactionInProgress() == true && _container.GetTransactionItem() is { } dragged && dragged != folder;
                            int target = dragging ? _container!.GetTransactionIndex() : -1;
                            bool down = dragging && _container!.IsItemMovedDownwards();
                            bool dropBefore = dragging && !down && index == target;
                            bool dropAfter = dragging && down && index == target;
                        }
                        @if (dropBefore)
                        {
                            <div class="drop" aria-hidden="true"></div>
                        }
                        <div role="group" aria-label="@($"Map {index + 1}")" class="fr">
                            <MudDragHandle T="ReplayFolder">
                                <MudIcon Icon="@Icons.Material.Outlined.DragIndicator" Title="@($"Verplaats {name}")" />
                            </MudDragHandle>
                            <MudTextField Label="Titel" Variant="Variant.Filled"
                                          @bind-Value="folder.Title" For="(() => folder.Title)" />
                            <MudTextField Label="Pad" Variant="Variant.Filled" Placeholder="C:\Games\World_of_Tanks_EU\replays"
                                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.FolderOpen"
                                          @bind-Value="folder.Path" For="(() => folder.Path)" />
                            <MudIconButton Icon="@Icons.Material.Outlined.ArrowUpward" aria-label="@($"{name} omhoog")"
                                           Disabled="@(index == 0)" OnClick="() => Move(folder, -1)" />
                            <MudIconButton Icon="@Icons.Material.Outlined.ArrowDownward" aria-label="@($"{name} omlaag")"
                                           Disabled="@(index == modal.ReplayFolders.Count - 1)" OnClick="() => Move(folder, 1)" />
                            <MudIconButton Icon="@Icons.Material.Outlined.Delete" aria-label="@($"{name} verwijderen")"
                                           Disabled="@(modal.ReplayFolders.Count == 1)" OnClick="() => Remove(folder)" />
                        </div>
                        @if (dropAfter)
                        {
                            <div class="drop" aria-hidden="true"></div>
                        }
                    </ItemRenderer>
                </MudDropContainer>
                <div>
                    <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Outlined.Add"
                               OnClick="Add">Map toevoegen</MudButton>
                </div>

                <MudDivider />
                <MudText Typo="Typo.overline" Color="Color.Tertiary">Laden</MudText>
                <MudDatePicker Label="Laad gevechten sinds" Variant="Variant.Filled" Style="max-width: 320px" HelperText="Geldt voor alle mappen."
                               DateFormat="dd-MM-yyyy" FirstDayOfWeek="DayOfWeek.Monday"
                               @bind-Date="@modal.LoadBattlesSince" For="(() => modal.LoadBattlesSince)" />

                <MudDivider />
                <MudText Typo="Typo.overline" Color="Color.Tertiary">Identiteit</MudText>
                <MudTextField Label="Clanafkorting" Variant="Variant.Filled"
                              @bind-Value="@modal.ClanAbbreviation" For="(() => modal.ClanAbbreviation)" />
                <MudTextField Label="Spelernaam" Variant="Variant.Filled" HelperText="Hiermee herkent de app jouw team"
                              @bind-Value="@modal.PlayerName" For="(() => modal.PlayerName)" />

                <MudDivider />
                <MudText Typo="Typo.overline" Color="Color.Tertiary">Gedrag</MudText>
                <MudStack Spacing="1">
                    <MudSwitch Color="Color.Primary" @bind-Value="@modal.SingleBattleResultOpenedOnly" For="(() => modal.SingleBattleResultOpenedOnly)">
                        <div>
                            <div>Maximaal één gevechtsresultaat open houden</div>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">Een geopend gevecht klapt de andere in.</MudText>
                        </div>
                    </MudSwitch>
                    <MudSwitch Color="Color.Primary" @bind-Value="@modal.OnlyHighlistOwnMatches" For="(() => modal.OnlyHighlistOwnMatches)">
                        <div>
                            <div>Alleen eigen gevechten uitlichten</div>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">Alleen jouw team krijgt een resultaatkleur.</MudText>
                        </div>
                    </MudSwitch>
                    <MudSwitch Color="Color.Primary" @bind-Value="@modal.UpdateScreeenWhileLoading" For="(() => modal.UpdateScreeenWhileLoading)">
                        <div>
                            <div>Scherm bijwerken tijdens het laden</div>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">Gevechten verschijnen terwijl ze worden gelezen.</MudText>
                        </div>
                    </MudSwitch>
                    <MudSwitch Color="Color.Primary" @bind-Value="@modal.AutoClanLookup" For="(() => modal.AutoClanLookup)">
                        <div>
                            <div>Clan automatisch opzoeken bij de start van een gevecht</div>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">Opent Clan gevecht zodra je clan tegen een andere clan speelt.</MudText>
                        </div>
                    </MudSwitch>
                </MudStack>
            </MudStack>
        </DialogContent>
        <DialogActions>
            <MudButton StartIcon="@Icons.Material.Outlined.OpenInNew" OnClick="AppInfo.Current.ShowSettingsUI" Class="mr-auto">Ga naar app-instellingen</MudButton>
            @if (CanCancel)
            {
                <MudButton OnClick="Cancel">Annuleren</MudButton>
            }
            <MudButton Variant="Variant.Filled" Color="Color.Primary" ButtonType="ButtonType.Submit">Opslaan</MudButton>
        </DialogActions>
    </MudDialog>
</EditForm>
@code {

    [CascadingParameter]
    public required IMudDialogInstance MudDialog { get; set; }

    [Parameter]
    public bool CanCancel { get; set; } = true;

    private Settings modal = new Settings();
    private EditContext _editContext = new(new Settings());
    private MudDropContainer<ReplayFolder>? _container;

    protected override void OnInitialized()
    {
        modal = new Settings
            {
                ReplayFolders = [.. SettingService.Settings.ReplayFolders.Select(f => new ReplayFolder { Title = f.Title, Path = f.Path })],
                LoadBattlesSince = SettingService.Settings.LoadBattlesSince,
                ClanAbbreviation = SettingService.Settings.ClanAbbreviation,
                PlayerName = SettingService.Settings.PlayerName,
                SingleBattleResultOpenedOnly = SettingService.Settings.SingleBattleResultOpenedOnly,
                OnlyHighlistOwnMatches = SettingService.Settings.OnlyHighlistOwnMatches,
                UpdateScreeenWhileLoading = SettingService.Settings.UpdateScreeenWhileLoading,
                AutoClanLookup = SettingService.Settings.AutoClanLookup
            };

        if (modal.ReplayFolders.Count == 0)
        {
            modal.ReplayFolders.Add(new ReplayFolder());
        }

        _editContext = new EditContext(modal);
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    private void Move(ReplayFolder folder, int by)
    {
        int index = modal.ReplayFolders.IndexOf(folder);
        modal.ReplayFolders.RemoveAt(index);
        modal.ReplayFolders.Insert(index + by, folder);
        _container?.Refresh();
    }

    private void Add()
    {
        modal.ReplayFolders.Add(new ReplayFolder());
        _container?.Refresh();
    }

    private void Remove(ReplayFolder folder)
    {
        modal.ReplayFolders.Remove(folder);
        _container?.Refresh();
    }

    // IndexInZone is the new place in the zone (MudBlazor's own sorting example uses it the same way).
    private void OnFolderDropped(MudItemDropInfo<ReplayFolder> drop)
    {
        if (drop.Item is null)
        {
            return;
        }

        modal.ReplayFolders.Remove(drop.Item);
        modal.ReplayFolders.Insert(Math.Min(drop.IndexInZone, modal.ReplayFolders.Count), drop.Item);
        _container?.Refresh();
    }

    private void OnSubmit(EditContext context)
    {
        // Validate() only reaches the Settings object, not the folders in its list: every row field is validated by hand,
        // which makes the DataAnnotationsValidator put each row's message on that field.
        bool valid = context.Validate();
        foreach (var folder in modal.ReplayFolders)
        {
            context.NotifyFieldChanged(new FieldIdentifier(folder, nameof(ReplayFolder.Title)));
            context.NotifyFieldChanged(new FieldIdentifier(folder, nameof(ReplayFolder.Path)));
        }

        if (!valid || context.GetValidationMessages().Any())
        {
            return;
        }

        // Only the first folder is read until #16 adds the selection, so only a new first path (or date) needs a reload.
        bool reloadNeeded = SettingService.Settings.ReplayFolders.FirstOrDefault()?.Path != modal.ReplayFolders[0].Path
            || SettingService.Settings.LoadBattlesSince != modal.LoadBattlesSince;
        SettingService.Settings = modal;

        SettingService.Save();

        if (reloadNeeded)
        {
            NavigationManager.NavigateTo(NavigationManager.Uri, forceLoad: true);
        }

        Snackbar.Add(BattleReportService.Notice("Opgeslagen", "instellingen zijn bewaard"), Severity.Success);
        MudDialog.Close(DialogResult.Ok(SettingService.Settings));
    }
}
