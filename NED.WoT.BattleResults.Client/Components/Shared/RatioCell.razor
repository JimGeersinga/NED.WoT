@* One stat cell of stats mode: the count on the left, the ratio on the right in its level colour plus a 16px Filled level icon (colour is never alone). Without a Ratio, Detail takes the right side in secondary text (Geschoten: p/m). The styling is inline: the cell is the same in every row, day header and footer. *@
<div class="wot-num" style="display: grid; grid-template-columns: minmax(0, 1fr) auto; column-gap: 6px; align-items: center; justify-items: end; white-space: nowrap">
	<span>@Count</span>
	@if (Ratio.HasValue)
	{
		<span title="@LevelWord" style="display: inline-flex; align-items: center; font-weight: 600; color: @Level.GetColor()">
			@Ratio%<svg viewBox="0 0 24 24" aria-hidden="true" style="width: 16px; height: 16px; fill: currentColor; margin-left: -2px">@((MarkupString)LevelIcon)</svg>
		</span>
	}
	else if (Detail != null)
	{
		<span class="mud-text-secondary">@Detail</span>
	}
</div>

@code {
	/// <summary>The count on the left (for block: "blocked / received").</summary>
	[Parameter, EditorRequired]
	public required string Count { get; set; }

	/// <summary>The ratio in whole percent. Null shows Detail instead.</summary>
	[Parameter]
	public int? Ratio { get; set; }

	[Parameter]
	public RatioLevel Level { get; set; }

	/// <summary>Secondary text on the right when there is no ratio.</summary>
	[Parameter]
	public string? Detail { get; set; }

	private string LevelIcon => Level switch
	{
		RatioLevel.Low => Icons.Material.Filled.ArrowDropDown,
		RatioLevel.High => Icons.Material.Filled.ArrowDropUp,
		_ => Icons.Material.Filled.Remove
	};

	private string LevelWord => Level switch
	{
		RatioLevel.Low => "Laag",
		RatioLevel.High => "Hoog",
		_ => "Gemiddeld"
	};
}
