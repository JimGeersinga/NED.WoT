@implements IBrowserViewportObserver
@implements IAsyncDisposable
@inject BattleReportService BattleReportService
@inject SettingService SettingService
@inject WargamingApiClient WargamingApi
@inject IdentityService Identity
@inject IBrowserViewportService ViewportService

<MudDialog Class="wot-dialog overflow-hidden" ContentClass="overflow-y-auto" TitleClass="wot-dialog-bar">
	<TitleContent>
		<WotDialogTitle Dialog="MudDialog">
			@if (Match.HasValue)
			{
				<MudStack Row Justify="Justify.Center" AlignItems="AlignItems.Center" Spacing="4">
					<MudText Typo="Typo.h4" HtmlTag="span">[@Match.Value.Item1]</MudText>
					<MudText Typo="Typo.h5" HtmlTag="span" Class="mud-text-secondary">vs</MudText>
					<MudText Typo="Typo.h4" HtmlTag="span">[@Match.Value.Item2]</MudText>
				</MudStack>
			}
		</WotDialogTitle>
	</TitleContent>
	<DialogContent>
		@if (Match.HasValue)
		{
			<MudStack Spacing="4" Class="pt-2">
				<MudStack Row Justify="Justify.Center" AlignItems="AlignItems.Center" Spacing="3" Class="flex-wrap">
					@ClanCard(Match.Value.Item1, OwnTag)
					<MudText Typo="Typo.h6" HtmlTag="span" Class="mud-text-secondary">vs</MudText>
					@ClanCard(Match.Value.Item2, OwnTag)
				</MudStack>
				@if (_state is RatingState.Failed)
				{
					<MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true">
						<MudStack Row AlignItems="AlignItems.Center" Spacing="3">
							<span><b>Ratings niet beschikbaar</b> · Wargaming gaf geen antwoord. Het gevecht zelf werkt gewoon.</span>
							<MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning" OnClick="LoadRatings">Opnieuw</MudButton>
						</MudStack>
					</MudAlert>
				}
				else
				{
					<MudText Typo="Typo.caption" Class="mud-text-secondary" Align="Align.Center">
						@(_state is RatingState.Loading ? "Ratings ophalen bij Wargaming…" : $"Ratings uit de Wargaming API · bijgewerkt {_updated:HH:mm} · PR = persoonlijke rating")
					</MudText>
				}

				<MudStack Row Justify="Justify.Center" Spacing="6" role="group" aria-label="Eerdere gevechten">
					@foreach (var (result, count) in new[] { (Result.Win, _battles.Count(x => x.Result is Result.Win)), (Result.Draw, _battles.Count(x => x.Result is Result.Draw)), (Result.Lose, _battles.Count(x => x.Result is Result.Lose)) })
					{
						<MudStack Row AlignItems="AlignItems.Center" Spacing="2">
							<MudText Typo="Typo.h5">@count</MudText>
							<ResultChip Result="result" />
						</MudStack>
					}
				</MudStack>

				@if (_narrow)
				{
					<MudTabs Class="wot-tabs" Elevation="0" TabPanelsClass="pt-4">
						<MudTabPanel Text="@OpponentsTitle">@Opponents</MudTabPanel>
						<MudTabPanel Text="@PastTitle">@Past</MudTabPanel>
					</MudTabs>
				}
				else
				{
					<MudGrid Spacing="4">
						<MudItem xs="7">
							<MudPaper Outlined Elevation="0" Class="overflow-hidden">
								<MudText Typo="Typo.h6" Class="px-4 py-3">@OpponentsTitle</MudText>
								@Opponents
							</MudPaper>
						</MudItem>
						<MudItem xs="5">
							<MudPaper Outlined Elevation="0" Class="overflow-hidden">
								<MudText Typo="Typo.h6" Class="px-4 py-3">@PastTitle</MudText>
								@Past
							</MudPaper>
						</MudItem>
					</MudGrid>
				}
			</MudStack>
		}
	</DialogContent>
	<DialogActions>
		<MudButton OnClick="Cancel">Sluiten</MudButton>
	</DialogActions>
</MudDialog>

@code {
	private string OpponentsTitle => $"Tegenstanders · {_enemyPlayers.Count}";
	private string PastTitle => $"Eerdere gevechten · {_battles.Count}";

	private RenderFragment Opponents => @<MudTable Items="@_enemyPlayers" Class="clan-match-table" Hover="true" Breakpoint="Breakpoint.None" Dense="true" Elevation="0">
		<HeaderContent>
			<MudTh Style="text-align: right; width: 110px" title="Gevechten" aria-label="Gevechten">
				<MudTableSortLabel InitialDirection="SortDirection.Descending" SortBy="new Func<IGrouping<string?, Player>, object>(x => x.Count())">#</MudTableSortLabel>
			</MudTh>
			<MudTh>
				<MudTableSortLabel SortBy="new Func<IGrouping<string?, Player>, object>(x => x.Key ?? string.Empty)">Speler</MudTableSortLabel>
			</MudTh>
			<MudTh>Tanks</MudTh>
			<MudTh Style="text-align: right">PR</MudTh>
		</HeaderContent>
		<RowTemplate>
			<MudTd DataLabel="Gevechten" Style="text-align: right; vertical-align: text-top;">@context.Count()</MudTd>
			<MudTd DataLabel="Speler" Style="vertical-align: text-top;">@context.Key</MudTd>
			<MudTd DataLabel="Tanks">
				@foreach (var vehicle in context.GroupBy(x => x.Vehicle).OrderByDescending(x => x.Count()))
				{
					<div class="d-flex justify-space-between gap-3">
						<span>@vehicle.Key</span>
						<MudText Typo="Typo.body2" Class="mud-text-secondary">@((int)Math.Round(100.0 * vehicle.Count() / context.Count(), MidpointRounding.AwayFromZero))%</MudText>
					</div>
				}
			</MudTd>
			<MudTd DataLabel="PR" Style="text-align: right; vertical-align: text-top;">@PlayerRatingCell(context.Key)</MudTd>
		</RowTemplate>
	</MudTable>;

	private RenderFragment PlayerRatingCell(string? name) => @<text>
		@if (_state is RatingState.Loading)
		{
			<MudSkeleton Width="48px" Class="ml-auto" />
		}
		else if (_state is RatingState.Ok && name is not null && _players.TryGetValue(name, out PlayerRating? rating) && rating.PersonalRating is { } pr)
		{
			@NumberFormat.Fmt(pr)
		}
		else if (_state is RatingState.Ok && name is not null && _players.TryGetValue(name, out PlayerRating? hidden) && hidden.StatsHidden)
		{
			<MudTooltip Text="Deze speler verbergt zijn statistieken, dus er is geen rating.">
				<span class="d-inline-flex align-center gap-1 mud-text-secondary" aria-label="Deze speler verbergt zijn statistieken, dus er is geen rating.">–<MudIcon Icon="@Icons.Material.Outlined.VisibilityOff" Size="Size.Small" /></span>
			</MudTooltip>
		}
		else
		{
			<span class="mud-text-secondary">–</span>
		}
	</text>;

	private RenderFragment ClanCard(string tag, string? ownTag) => @<MudPaper Outlined Elevation="0" Class="pa-3" Style="min-width: 300px; flex: 1 1 300px; max-width: 460px;">
		<MudStack Row AlignItems="AlignItems.Center" Spacing="3">
			@if (_clans.TryGetValue(tag, out ClanRating? clan) && clan.EmblemUrl is { } emblem)
			{
				<img src="@emblem" alt="" width="40" height="40" />
			}
			<MudStack Spacing="0" Style="min-width: 0; flex: 1">
				<MudText Typo="Typo.h6">[@tag]</MudText>
				<MudText Typo="Typo.body2" Class="mud-text-secondary">
					@(_clans.TryGetValue(tag, out ClanRating? named) ? named.Name + " · " : null)@(ownTag is not null && tag.Equals(ownTag, StringComparison.OrdinalIgnoreCase) ? "jouw clan" : "tegenstander")
				</MudText>
			</MudStack>
			<MudStack Spacing="0" Style="text-align: right;">
				<MudText Typo="Typo.caption" Class="mud-text-secondary">Clanrating</MudText>
				@if (_state is RatingState.Loading)
				{
					<MudSkeleton Width="64px" Class="ml-auto" />
				}
				else if (_state is RatingState.Ok && _clans.TryGetValue(tag, out ClanRating? rated) && rated.Rating is { } value)
				{
					<MudText Typo="Typo.h6">@NumberFormat.Fmt(value)</MudText>
					@if (rated.Rank is { } rank)
					{
						<MudText Typo="Typo.caption" Class="mud-text-secondary">Rang @rank</MudText>
					}
				}
				else
				{
					<MudText Typo="Typo.h6" Class="mud-text-secondary">–</MudText>
				}
			</MudStack>
		</MudStack>
	</MudPaper>;

	private RenderFragment Past => @<MudTable Items="@_battles" Class="clan-match-table" Hover="true" Breakpoint="Breakpoint.None" Dense="true" Elevation="0">
		<HeaderContent>
			<MudTh>
				<MudTableSortLabel InitialDirection="SortDirection.Ascending" SortBy="new Func<BattleReport, object>(x => x.MatchStart)">Datum</MudTableSortLabel>
			</MudTh>
			<MudTh Style="text-align: right">
				<MudTableSortLabel SortBy="new Func<BattleReport, object?>(x => x.MatchDuration)">Duur</MudTableSortLabel>
			</MudTh>
			<MudTh>
				<MudTableSortLabel SortBy="new Func<BattleReport, object>(x => x.MapName ?? string.Empty)">Map</MudTableSortLabel>
			</MudTh>
			<MudTh Style="text-align: right">Winnaar</MudTh>
		</HeaderContent>
		<RowTemplate>
			@{
				Team? ownTeam = context.OwnTeam;
			}
			<MudTd DataLabel="Datum">@context.MatchTimeDisplay</MudTd>
			<MudTd DataLabel="Duur" Style="text-align: right" Class="mud-text-secondary">@context.MatchDurationDisplay</MudTd>
			<MudTd DataLabel="Map"><b>@context.MapName</b> @ownTeam?.Base</MudTd>
			<MudTd DataLabel="Winnaar" Style="text-align: right">
				<MudStack Row Justify="Justify.FlexEnd" AlignItems="AlignItems.Center" Spacing="2">
					<span class="@ownTeam?.Result.ToString()">@(context.Team1.IsWinner == true ? context.Team1.Abbreviation : context.Team2.Abbreviation)</span>
					@if (ownTeam is not null)
					{
						<ResultChip Result="ownTeam.Result" IconRight="true" />
					}
				</MudStack>
			</MudTd>
		</RowTemplate>
	</MudTable>;

	[CascadingParameter]
	public required IMudDialogInstance MudDialog { get; set; }

	[Parameter]
	public (string, string)? Match { get; set; }

	private enum RatingState { Loading, Ok, Failed }

	private RatingState _state = RatingState.Loading;
	private DateTime _updated;
	private Dictionary<string, PlayerRating> _players = new(StringComparer.OrdinalIgnoreCase);
	private Dictionary<string, ClanRating> _clans = new(StringComparer.OrdinalIgnoreCase);
	private CancellationTokenSource _cts = new();

	private string? OwnTag => Identity.Current?.ClanTag;

	private List<BattleReport> _battles = [];
	private List<IGrouping<string?, Player>> _enemyPlayers = [];

	protected override void OnParametersSet()
	{
		if (Match is not null)
		{
			_battles = BattleReportService.BattleReports
				.Where(x =>
					(x.Value.Team1.Abbreviation?.Equals(Match.Value.Item1, StringComparison.OrdinalIgnoreCase) ?? false) &&
					(x.Value.Team2.Abbreviation?.Equals(Match.Value.Item2, StringComparison.OrdinalIgnoreCase) ?? false)
					||
					(x.Value.Team1.Abbreviation?.Equals(Match.Value.Item2, StringComparison.OrdinalIgnoreCase) ?? false) &&
					(x.Value.Team2.Abbreviation?.Equals(Match.Value.Item1, StringComparison.OrdinalIgnoreCase) ?? false)
				)
				.Select(x => x.Value)
				.ToList();

			_enemyPlayers = _battles
				.Select(x => x.OwnTeam == x.Team1 ? x.Team2 : x.Team1)
				.SelectMany(x => x.Players)
				.GroupBy(x => x.Name)
				.OrderByDescending(x => x.Count())
				.ToList();
		}
	}

	private async Task LoadRatings()
	{
		await _cts.CancelAsync();
		_cts.Dispose();
		_cts = new CancellationTokenSource();
		CancellationToken ct = _cts.Token;
		_state = RatingState.Loading;
		StateHasChanged();
		try
		{
			string[] tags = [Match!.Value.Item1, Match.Value.Item2];
			string[] names = _enemyPlayers.Where(x => x.Key is not null).Select(x => x.Key!).ToArray();
			Task<ClanRatingResult>[] clanTasks = tags.Select(t => WargamingApi.GetClanRatingAsync(t, ct)).ToArray();
			RatingsResult players = await WargamingApi.GetPlayerRatingsAsync(names, ct);
			ClanRatingResult[] clans = await Task.WhenAll(clanTasks);
			if (ct.IsCancellationRequested)
			{
				return;
			}

			if (players.Ok && clans.All(x => x.Ok))
			{
				_players = players.Players.ToDictionary(x => x.Nickname, StringComparer.OrdinalIgnoreCase);
				_clans = clans.Select(x => x.Clan).OfType<ClanRating>().ToDictionary(x => x.Tag, StringComparer.OrdinalIgnoreCase);
				_updated = DateTime.Now;
				_state = RatingState.Ok;
			}
			else
			{
				_state = RatingState.Failed;
			}
		}
		catch (OperationCanceledException)
		{
			return; // a newer load (Opnieuw) or the dialog closing took over
		}
		catch (Exception)
		{
			_state = RatingState.Failed; // never leave the skeleton hanging
		}

		await InvokeAsync(StateHasChanged);
	}

	void Cancel() => MudDialog.Close(DialogResult.Ok(true));

	// Below 1100px wide the two tables become tabs (docs/DESIGN.md, ".wot-tabs"); MudBlazor's own breakpoints (960, 1280) do not fall there.
	private const int TabsBelowWidth = 1100;
	private bool _narrow;

	Guid IBrowserViewportObserver.Id { get; } = Guid.NewGuid();

	MudBlazor.Services.ResizeOptions? IBrowserViewportObserver.ResizeOptions { get; } = new() { NotifyOnBreakpointOnly = false };

	Task IBrowserViewportObserver.NotifyBrowserViewportChangeAsync(BrowserViewportEventArgs e)
	{
		bool narrow = e.BrowserWindowSize.Width < TabsBelowWidth;
		if (narrow == _narrow)
		{
			return Task.CompletedTask;
		}

		_narrow = narrow;
		return InvokeAsync(StateHasChanged);
	}

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender)
		{
			// The dialog is already showing; the ratings arrive when Wargaming answers (never awaited here).
			if (Match.HasValue)
			{
				_ = LoadRatings();
			}

			await ViewportService.SubscribeAsync(this);
		}
	}

	public async ValueTask DisposeAsync()
	{
		await _cts.CancelAsync();
		await ViewportService.UnsubscribeAsync(this);
	}
}
