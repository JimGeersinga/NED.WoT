@page "/"
@attribute [Authorize]

@using System.Collections.ObjectModel;
@using System.Collections.Specialized;
@using System.Diagnostics;
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization

@inject BattleReportService BattleResultService;
@inject SettingService SettingService;
@inject IJSRuntime JSRuntime;
@inject IDialogService DialogService;

@{
	// One pass per render: the battles that pass the search and the match type (the totals follow these), then their days.
	var filtered = _reports.Where(TableFilter).ToList();
	var days = BuildDays(filtered);
	// The table shows the rows under the result chips (a day without one drops out by itself); the day header and the footer count the whole day.
	var dayByLabel = days.ToDictionary(d => d.Label);
	var numbers = days.SelectMany(d => d.Items.Select((r, i) => (r, d.Items.Count - i))).ToDictionary(t => t.r, t => t.Item2);
	var visible = filtered.Where(x => _resultVisibility[x.Result]).OrderByDescending(x => x.MatchStart).ToList();
	var template = _showBattleStats ? "g-s" : "g-n";
	var clanMembers = filtered.SelectMany(x => x.Team1.Players.Concat(x.Team2.Players)).Where(x => x.IsClanMember).Select(x => x.Name).Distinct().Count();
	var undefinedNames = TankNameResolver.UndefinedTankNames.Count + MapNameResolver.UndefinedMapNames.Count;
}

<div class="gl-page">
	<section class="gl-bar" aria-label="Filters">
		<div class="gl-search">
			<MudAutocomplete T="SearchValue"
							 @bind-Value="_search"
							 SearchFunc="SearchAllAsync"
							 ToStringFunc="@(e=> e == null ? null : $"{e.Value} ({e.Type})")"
							 DebounceInterval="500"
							 Placeholder="Zoek op spelernaam of clan tag"
							 Adornment="Adornment.Start"
							 AdornmentIcon="@Icons.Material.Filled.Search"
							 IconSize="Size.Medium"
							 Variant="Variant.Outlined"
							 Margin="Margin.Dense"
							 Clearable="true"
							 Class="mt-0">
				<ItemTemplate Context="e">
					<div class="d-flex justify-space-between align-center">
						<MudText Typo="Typo.inherit">@e.Value</MudText>
						<MudText Typo="Typo.caption">@e.Type</MudText>
					</div>
				</ItemTemplate>
			</MudAutocomplete>
		</div>

		<MudToggleGroup T="MatchType" @bind-Value="_matchType" Class="wot-view-toggle" aria-label="Soort gevechten">
			@foreach (var matchType in Enum.GetValues<MatchType>())
			{
				<MudToggleItem Value="matchType" Text="@matchType.ToString()" />
			}
		</MudToggleGroup>

		<div class="gl-chips" role="group" aria-label="Resultaat">
			@foreach (var result in _resultVisibility.Keys)
			{
				var shown = _resultVisibility[result];
				<MudChip T="string" Class="wot-filter-chip" Selected="@shown" OnClick="() => ToggleResultVisibilty(result)" aria-pressed="@(shown ? "true" : "false")">
					@ResultChip.Word(result)<span class="wot-num ml-1">@filtered.Count(x => x.Result == result)</span>
				</MudChip>
			}
		</div>

		<div class="gl-tools">
			@if (_canToggleBattleStats)
			{
				if (_showBattleStats)
				{
					<div class="gl-player">
						<MudAutocomplete @bind-Value="_detailedInfoForPlayer"
										 SearchFunc="SearchPlayerAsync"
										 DebounceInterval="500"
										 Placeholder="Filter speler stats"
										 Adornment="Adornment.Start"
										 AdornmentIcon="@Icons.Material.Filled.AutoGraph"
										 IconSize="Size.Medium"
										 Margin="Margin.Dense"
										 Variant="Variant.Outlined"
										 Clearable="true"
										 Class="mt-0"></MudAutocomplete>
					</div>
				}

				<button type="button" class="gl-imgbtn gl-icon-only gl-book" aria-pressed="@(_showBattleStats ? "true" : "false")" aria-label="Statistieken" title="Uitgebreide statistieken" @onclick="() => _showBattleStats = !_showBattleStats">
					<img src="@(_showBattleStats ? "images/book-open.png" : "images/book-closed.png")" alt="" />
				</button>
			}

			<button type="button" class="gl-imgbtn gl-icon-only" aria-label="Clanleden, @clanMembers" title="Clanleden" @onclick="OpenClanMembersDialog">
				<img src="images/crew.png" alt="" /><span class="gl-badge">@clanMembers</span>
			</button>

			@if (undefinedNames > 0)
			{
				<button type="button" class="gl-imgbtn gl-icon-only gl-warn" aria-label="@undefinedNames onbekende mapnamen en tanknamen" title="Onbekende mapnamen en tanknamen" @onclick="OpenUndefinedNamesDialog">
					<img src="images/CrewSkill_Commander_sixthSense.png" alt="" /><span class="gl-badge">@undefinedNames</span>
				</button>
			}
		</div>
	</section>

	<MudTable T="BattleReport"
			  Items="visible"
			  GroupBy="_groupDefinition"
			  Virtualize="true"
			  ItemSize="48"
			  FixedHeader="true"
			  FixedFooter="true"
			  Height="100%"
			  Hover="true"
			  Elevation="0"
			  Class="wot-battle-table"
			  GroupHeaderClass="gl-day"
			  RowClassFunc="@RowClass"
			  OnRowClick="@(e => ToggleShowDetailsAsync(e.Item))">
		<ColGroup>
			<col class="c-chev" />
			<col class="c-num" />
			<col class="c-time" />
			<col class="c-map" />
			<col />
			@if (_showBattleStats)
			{
				<col class="c-stat" /><col class="c-stat" /><col class="c-stat" /><col class="c-stat" />
			}
			<col class="c-res" />
			<col class="c-copy" />
		</ColGroup>
		<HeaderContent>
			<MudTh>
				<button type="button" class="gl-ibtn" aria-label="Alles inklappen" title="Alles inklappen" @onclick="CollapseAllBattleReports">
					<svg viewBox="0 0 24 24" aria-hidden="true">@((MarkupString)Icons.Material.Outlined.UnfoldLess)</svg>
				</button>
			</MudTh>
			<MudTh Class="c">#</MudTh>
			<MudTh>
				<MudTableSortLabel T="BattleReport" SortBy="@(x => x.MatchStart)" InitialDirection="SortDirection.Descending">Tijd · duur</MudTableSortLabel>
			</MudTh>
			<MudTh Class="mapcol"><div class="mapc"><span>Map</span><span></span></div></MudTh>
			<MudTh>Team 1 · Team 2</MudTh>
			@if (_showBattleStats)
			{
				<MudTh Class="r">Geschoten</MudTh>
				<MudTh Class="r">Geraakt</MudTh>
				<MudTh Class="r">Gepenetreerd</MudTh>
				<MudTh Class="r">Geblokt</MudTh>
			}
			<MudTh Class="res">Resultaat</MudTh>
			<MudTh></MudTh>
		</HeaderContent>
		<GroupHeaderTemplate>
			@{
				var day = dayByLabel[(string)context.Key];
			}
			<MudTh colspan="5">
				<div class="gl">
					<MudText Typo="Typo.h6" HtmlTag="h2">@day.Label</MudText>
					<MudText Typo="Typo.caption" Class="mud-text-secondary wot-num">@day.Date.ToString("dd-MM-yyyy")</MudText>
					<BattleTotals Reports="day.Items" ShowRecord="!_showBattleStats" />
				</div>
			</MudTh>
			@if (_showBattleStats)
			{
				@StatCells(day.Items)
			}
			<MudTh></MudTh>
			<MudTh Class="p4">
				<button type="button" class="gl-ibtn out" aria-label="Kopieer opstellingen van deze dag" title="Kopieer opstellingen van deze dag" @onclick="() => CopyResultAsync(day.Items)">
					<svg viewBox="0 0 24 24" aria-hidden="true">@((MarkupString)Icons.Material.Filled.ContentCopy)</svg>
				</button>
			</MudTh>
		</GroupHeaderTemplate>
		<RowTemplate>
			@if (context.Error != null)
			{
				<MudTd colspan="@(_showBattleStats ? 11 : 7)" Class="gl-err"><svg viewBox="0 0 24 24" aria-hidden="true">@((MarkupString)Icons.Material.Filled.Warning)</svg>@context.Error</MudTd>
			}
			else
			{
				var ownTeam = context.OwnTeam;
				var left = context.Team1;
				var right = context.Team2;
				var leftKills = right.Players.Count(x => x.DeathReason.HasValue && x.DeathReason != -1);
				var rightKills = left.Players.Count(x => x.DeathReason.HasValue && x.DeathReason != -1);
				var onlyOwn = SettingService.Settings.OnlyHighlistOwnMatches;

				<MudTd Class="p4">
					<a id="@($"Timestamp_{context.MatchStart.Ticks + context.MatchDuration.GetValueOrDefault()}_anchor")" class="gl-anchor"></a>
					<button type="button" class="gl-ibtn" aria-label="@(context.ShowDetails ? "Details inklappen" : "Details uitklappen")" aria-expanded="@(context.ShowDetails ? "true" : "false")">
						<svg viewBox="0 0 24 24" aria-hidden="true">@((MarkupString)(context.ShowDetails ? Icons.Material.Filled.KeyboardArrowDown : Icons.Material.Filled.KeyboardArrowRight))</svg>
					</button>
				</MudTd>
				<MudTd Class="c gl-dim">@numbers[context]</MudTd>
				<MudTd title="@context.MatchTimeTooltip">
					<div class="two"><b>@context.MatchStart.ToString("HH:mm")@(context.MatchEnd.HasValue ? $" – {context.MatchEnd.Value:HH:mm}" : string.Empty)</b><small>@context.MatchDurationDisplay</small></div>
				</MudTd>
				<MudTd Class="mapcol"><div class="mapc"><b title="@context.MapName">@context.MapName</b><span class="gl-chip">@ownTeam?.Base</span></div></MudTd>
				<MudTd>
					<span class="vs">
						<span class="@TagClass(left, left == ownTeam, onlyOwn)">@left.Abbreviation</span>
						<span class="score">@(left.Result is Result.Win ? (MarkupString)$"<b>{leftKills}</b>" : (MarkupString)$"<span>{leftKills}</span>")–@(right.Result is Result.Win ? (MarkupString)$"<b>{rightKills}</b>" : (MarkupString)$"<span>{rightKills}</span>")</span>
						<span class="@TagClass(right, right == ownTeam, onlyOwn)">@right.Abbreviation</span>
					</span>
				</MudTd>
				@if (_showBattleStats)
				{
					@StatCells(new[] { context })
				}
				<MudTd Class="res"><ResultChip Result="context.Result" /></MudTd>
				<MudTd Class="p4">
					<button type="button" class="gl-ibtn out" aria-label="Kopieer opstelling" title="Kopieer opstelling" disabled="@(ownTeam == null)" @onclick="() => CopyResultAsync(context, ownTeam)" @onclick:stopPropagation="true">
						<svg viewBox="0 0 24 24" aria-hidden="true">@((MarkupString)Icons.Material.Filled.ContentCopy)</svg>
					</button>
				</MudTd>
			}
		</RowTemplate>
		<ChildRowContent>
			@if (context.ShowDetails)
			{
				<MudTr>
					<MudTd colspan="@(_showBattleStats ? 11 : 7)" Class="@("gl-details" + (SettingService.Settings.OnlyHighlistOwnMatches ? " highlight-own-result" : null))" data-report="@context.FileName">
						<Details Report="@context" ShowBattleStats="_showBattleStats" />
					</MudTd>
				</MudTr>
			}
		</ChildRowContent>
		<FooterContent>
			<MudTh colspan="5">
				<div class="gl">
					<MudText Typo="Typo.h6" HtmlTag="h2">Totaal</MudText>
					<MudText Typo="Typo.caption" Class="mud-text-secondary wot-num">sinds @SettingService.Settings.LoadBattlesSince?.ToString("dd-MM-yyyy")</MudText>
					<BattleTotals Reports="filtered" ShowRecord="!_showBattleStats" Suffix="@(_loadingTime == TimeSpan.Zero ? null : $" · geladen in {_loadingTime.TotalSeconds.ToString("0.0", BattleReport.DutchCulture)} s")" />
				</div>
			</MudTh>
			@if (_showBattleStats)
			{
				@StatCells(filtered)
			}
			<MudTh></MudTh>
			<MudTh></MudTh>
		</FooterContent>
	</MudTable>
</div>

@code {
	public enum MatchType
	{
		Alles,
		Normaal,
		Clan,
		Onbekend
	}

	[CascadingParameter]
	public required Task<AuthenticationState> AuthenticationState { get; set; }

	private bool _loading = true;
	private bool _loadedOnce;
	private string? _addedFile;
	private SearchValue? _search;
	private MatchType _matchType = MatchType.Clan;
	private TimeSpan _loadingTime = TimeSpan.Zero;

	private bool _canToggleBattleStats = false;
	private bool _showBattleStats = false;
	private string _detailedInfoForPlayer = string.Empty;

	private Dictionary<Result, bool> _resultVisibility = new Dictionary<Result, bool>
	{
		{ Result.Win, true },
		{ Result.Draw, true },
		{ Result.Lose, true },
		{ Result.Unknown, true }
	};

	private IDialogReference? _clanMatchDialog;

	private List<BattleReport> _reports = new List<BattleReport>();
	private IEnumerable<BattleReport> _filteredReports => _reports.Where(x => TableFilter(x));
	private TableGroupDefinition<BattleReport> _groupDefinition = new()
	{
		Indentation = false,
		Expandable = false,
		Selector = (e) => e.Group
	};

	private string RowClass(BattleReport report, int index) => "gl-row"
		+ (index % 2 == 1 ? " alt" : string.Empty)
		+ (report.ShowDetails ? " wot-row-active" : string.Empty)
		+ (report.FileName == _addedFile ? " gl-new" : string.Empty);

	/// <summary>One day of battles, newest first. The number of a battle in its day is its place counted from the oldest (oldest = 1).</summary>
	private sealed record Day(string Label, DateTime Date, List<BattleReport> Items);

	private static List<Day> BuildDays(IEnumerable<BattleReport> reports) => reports
		.GroupBy(x => x.Group)
		.Select(x => new Day(x.Key, x.First().GroupDate, x.OrderByDescending(r => r.MatchStart).ToList()))
		.OrderByDescending(x => x.Items[0].MatchStart)
		.ToList();

	[Conditional("DEBUG")]
	private static void SelfCheck()
	{
		DateTime today = DateTime.Now.Date;
		List<BattleReport> reports = new[] { (19, 12), (19, 40), (20, 5), (20, 31), (21, 2) }
			.Select(x => new BattleReport { MatchStart = today.AddHours(x.Item1).AddMinutes(x.Item2) })
			.ToList();
		List<Day> days = BuildDays(reports);

		Debug.Assert(days.Count == 1 && days[0].Label == "Vandaag", "five battles today are one day");
		Debug.Assert(days[0].Items.Count - days[0].Items.FindIndex(x => x.MatchStart.Hour == 19 && x.MatchStart.Minute == 12) == 1, "the 19:12 battle is #1");
		Debug.Assert(days[0].Items.Count - 0 == 5, "the newest battle is #5");
		Debug.Assert(days[0].Date == today, "the day header shows today's date");
		Debug.Assert(new BattleReport { MatchStart = today.AddHours(1) }.GroupDate == today.AddDays(-1), "a battle at 01:00 counts for the previous day");

		BattleTotals.SelfCheck();
	}

	/// <summary>The stat columns of stats mode for a set of battles: the total of the own team's players (or of the chosen player).</summary>
	private RenderFragment<IEnumerable<BattleReport>> StatCells => reports => @<text>
		@{
			var players = reports.SelectMany(x => x.OwnTeam?.Players ?? []).ToList();

			if (!string.IsNullOrEmpty(_detailedInfoForPlayer))
			{
				players = players.Where(x => x.Name?.Equals(_detailedInfoForPlayer, StringComparison.OrdinalIgnoreCase) ?? false).ToList();
			}

			var totalLifeTime = players.Sum(x => x.LifeTime);
			var totalShots = players.Sum(x => x.Shots);
			var totalHits = players.Sum(x => x.DirectHits);
			var totalPens = players.Sum(x => x.Piercings);
			var totalShotsReceived = players.Sum(x => x.ShotsReceived);
			var totalBlocked = players.Sum(x => x.ShotsBlocked);

			var shotRatio = totalShots == 0 ? 0 : totalShots.GetValueOrDefault() / (totalLifeTime.GetValueOrDefault() / 60m);
			var hitRatio = totalShots == 0 ? 0 : (int)(100m / totalShots.GetValueOrDefault() * totalHits.GetValueOrDefault());
			var penRatio = totalHits == 0 ? 0 : (int)(100m / totalHits.GetValueOrDefault() * totalPens.GetValueOrDefault());
			var blockRatio = totalShotsReceived == 0 ? 0 : (int)(100m / totalShotsReceived.GetValueOrDefault() * totalBlocked.GetValueOrDefault());
		}
		<td class="gc s">
			<div class="d-flex justify-space-between gap-1 text-nowrap">
				@if (totalShots.HasValue)
				{
					var roundedRatio = Math.Round(shotRatio);

					<span>@totalShots</span>
					<span style="color: var(--mud-palette-text-secondary)">@(shotRatio < roundedRatio ? " < " : " > ") @roundedRatio p/m</span>
				}
			</div>
		</td>
		<td class="gc s">
			<div class="d-flex justify-space-between gap-1 text-nowrap">
				<span>@totalHits</span>
				<span style="color: @hitRatio.GetHitRatioColor()">@hitRatio%</span>
			</div>
		</td>
		<td class="gc s">
			<div class="d-flex justify-space-between gap-1 text-nowrap">
				<span>@totalPens</span>
				<span style="color: @penRatio.GetPenRatioColor()">@penRatio%</span>
			</div>
		</td>
		<td class="gc s">
			<div class="gap-1 text-nowrap" style="display: grid; grid-template-columns: 1fr auto 1fr 40px">
				<span class="text-right">@totalBlocked</span>
				<span class="mx-2">/</span>
				<span>@totalShotsReceived</span>
				<span class="text-right" style="color: @blockRatio.GetBlockedRatioColor()">@blockRatio%</span>
			</div>
		</td>
	</text>;

	/// <summary>A team tag in the VS cell (Team 1 left, Team 2 right): coloured by the team's result, and with the clan-chip edge when it is the own team. With "Alleen eigen gevechten uitlichten" only the own tag is coloured.</summary>
	private static string TagClass(Team team, bool own, bool onlyOwn)
	{
		string colour = onlyOwn && !own ? "u" : team.Result switch
		{
			Result.Win => "w",
			Result.Lose => "l",
			Result.Draw => "d",
			_ => "u",
		};

		return own ? $"tag own {colour}" : $"tag {colour}";
	}

	protected override async Task OnInitializedAsync()
	{
		SelfCheck();

		long timestamp = 0;

		AuthenticationState authResult = await AuthenticationState;
		_canToggleBattleStats = authResult.User.HasClaim(Claims.CanSeeBattleStats, bool.TrueString);

		BattleResultService.LoadingBattleReportsStarted += async (s, e) =>
		{
			await InvokeAsync(async () =>
			{
				timestamp = Stopwatch.GetTimestamp();

				// A battle added by the file watcher: keep the table as it is, so the new row can show up in place.
				if (_loadedOnce)
				{
					return;
				}

				_reports = new List<BattleReport>();
				_loading = true;
				StateHasChanged();

				while (_loading && SettingService.Settings.UpdateScreeenWhileLoading)
				{
					await Task.Delay(500);
					StateHasChanged();
				}
			});
		};

		BattleResultService.BattleReportAdded += async (s, e) =>
		{
			await InvokeAsync(() =>
			{
				_reports.Add(e.Report);
				_clanMatchDialog?.Close();
				if (_loading)
				{
					_loadingTime = Stopwatch.GetElapsedTime(timestamp);
				}
				else if (_loadedOnce)
				{
					_addedFile = e.Report.FileName;
				}
			});
		};

		BattleResultService.BattleReportRemoved += async (s, e) =>
		{
			await InvokeAsync(() =>
			{
				_reports.Remove(e.Report);
				StateHasChanged();
			});
		};

		BattleResultService.LoadingBattleReportsFinished += async (s, e) =>
		{
			await InvokeAsync(async () =>
			{
				_reports = BattleResultService.BattleReports.Select(x => x.Value).OrderByDescending(x => x.MatchStart).ToList();
				_loading = false;
				if (!_loadedOnce)
				{
					_loadingTime = Stopwatch.GetElapsedTime(timestamp);
				}

				_loadedOnce = true;
				StateHasChanged();

				// The row the watcher added stays quietly highlighted for 2 seconds, unless a newer one took over.
				string? added = _addedFile;
				if (added != null)
				{
					await Task.Delay(2000);
					if (_addedFile == added)
					{
						_addedFile = null;
						StateHasChanged();
					}
				}
			});
		};

		BattleResultService.ClanMatchStarted += async (s, e) =>
		{
			await InvokeAsync(async () =>
			{
				if (!SettingService.Settings.AutoClanLookup)
				{
					return;
				}

				await OpenClanMatchDialog(e);
			});
		};

		await Task.Run(() => BattleResultService.LoadBattleReports());

		_loading = false;
	}

	private bool TableFilter(BattleReport report)
	{
		bool show = false;

		var isNormalMatch = (report.Team1.Abbreviation == null || report.Team1.Abbreviation == "?") &&
							(report.Team2.Abbreviation == null || report.Team2.Abbreviation == "?");

		if (_matchType is MatchType.Clan && isNormalMatch)
			show = false;
		else if (_matchType is MatchType.Normaal && !isNormalMatch)
			show = false;
		else if (_matchType is MatchType.Onbekend && report.Result is not Result.Unknown)
			show = false;
		else if (string.IsNullOrWhiteSpace(_search?.Value))
			show = true;
		else if (report.Team1.Abbreviation?.Equals(_search?.Value, StringComparison.OrdinalIgnoreCase) ?? false)
			show = true;
		else if (report.Team2.Abbreviation?.Equals(_search?.Value, StringComparison.OrdinalIgnoreCase) ?? false)
			show = true;
		else if (report.Team1.Players.Any(x => x.Name?.Equals(_search?.Value, StringComparison.OrdinalIgnoreCase) ?? false))
			show = true;
		else if (report.Team2.Players.Any(x => x.Name?.Equals(_search?.Value, StringComparison.OrdinalIgnoreCase) ?? false))
			show = true;

		return show;
	}

	private Task<IEnumerable<SearchValue>> SearchAllAsync(string value, CancellationToken token)
	{
		var playerNames = _reports
		.SelectMany(x => x.Team1.Players.Concat(x.Team2.Players))
		.Select(x => new SearchValue(x.Name, "Speler"))
		.Distinct();

		var teamNames = _reports
		.SelectMany(x => new[] { x.Team1.Abbreviation, x.Team2.Abbreviation })
		.Select(x => new SearchValue(x, "Clan"))
		.Distinct();

		var names = teamNames.Concat(playerNames);

		if (string.IsNullOrEmpty(value))
		{
			return Task.FromResult(names);
		}

		return Task.FromResult(names.Where(x => x?.Value?.Contains(value, StringComparison.InvariantCultureIgnoreCase) ?? false));
	}

	private Task<IEnumerable<string>> SearchPlayerAsync(string value, CancellationToken token)
	{
		var playerNames = _reports.SelectMany(x => x.Team1.Players.Concat(x.Team2.Players)).Select(x => x.Name ?? string.Empty).Distinct();
		if (string.IsNullOrEmpty(value))
		{
			return Task.FromResult(playerNames);
		}

		return Task.FromResult(playerNames.Where(x => x?.Contains(value, StringComparison.InvariantCultureIgnoreCase) ?? false));
	}

	private void CollapseAllBattleReports()
	{
		foreach (var report in _reports)
		{
			report.ShowDetails = false;
		}
	}

	private async Task ToggleShowDetailsAsync(BattleReport report)
	{
		if (!report.ShowDetails && SettingService.Settings.SingleBattleResultOpenedOnly)
		{
			CollapseAllBattleReports();
		}

		report.ShowDetails = !report.ShowDetails;
		if (report.ShowDetails)
		{
			await JSRuntime.InvokeVoidAsync("scrollIntoView", $"Timestamp_{report.MatchStart.Ticks + report.MatchDuration.GetValueOrDefault()}_anchor");
		}
	}

	private async Task CopyResultAsync(BattleReport report, Team? team)
	{
		await Clipboard.SetTextAsync(team?.GetResult(report.MapName) ?? string.Empty);
	}

	private async Task CopyResultAsync(IEnumerable<BattleReport> reports)
	{
		List<string?> results = reports.Select(x => x.OwnTeam?.GetResult(x.MapName)).Reverse().ToList();
		var splitResults = results
				.Select(r => r?.Split(Environment.NewLine, StringSplitOptions.RemoveEmptyEntries) ?? [])
				.ToList();

		int maxLines = splitResults.Max(lines => lines.Length);

		IEnumerable<string> outputLines = Enumerable.Range(0, maxLines)
			.Select(i =>
			{
				var lineEntries = splitResults
					.Select(lines => i < lines.Length ? lines[i] : string.Empty)
					.ToArray();

				return string.Join("\t\t", lineEntries);
			});

		string output = string.Join(Environment.NewLine, outputLines);

		await Clipboard.SetTextAsync(output);
	}

