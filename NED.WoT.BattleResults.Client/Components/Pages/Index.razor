@page "/"
@attribute [Authorize]

@using System.Collections.ObjectModel;
@using System.Collections.Specialized;
@using System.Diagnostics;
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization

@inject BattleReportService BattleResultService;
@inject SettingService SettingService;
@inject IdentityService Identity;
@inject IJSRuntime JSRuntime;
@inject IDialogService DialogService;
@inject ISnackbar Snackbar;


@{
	// One pass per render: the readable battles that pass the Clangevechten | Alles switch, the clan and the player (the Map list counts these), then the map (the totals follow these), then their days.
	var readable = _reports.Where(x => x.Error == null).ToList();
	var scoped = readable.Where(x => InScope(x, _clanOnly, _clan, _player)).ToList();
	var filtered = scoped.Where(x => OnMaps(x, _maps)).ToList();
	// The table shows the battles under the Resultaat dropdown (a day without one drops out by itself); the day header and the footer count the whole day.
	var battles = filtered.Where(x => ShownResult(x, _results)).ToList();
	// A replay that can't be read is a warning row of its own, never in a count, and only next to battle rows: a clan, player, map or result filter hides it, and without a battle row the empty state speaks.
	var unreadable = UnreadableShown(battles.Count, _clan is null && _player is null && _maps.Count == 0 && _results.Count == 0, _reports);
	// The clan and player lookup of the filter bar: one instance, told the battles of this render; it rebuilds its tables on the next search only when _battlesVersion (or your own clan tag) changed.
	_filters ??= BattleFilters.Build(readable, Identity.Current?.ClanTag);
	_filters.Refresh(readable, _battlesVersion, Identity.Current?.ClanTag);
	var days = BuildDays(filtered, unreadable);
	var dayByLabel = days.ToDictionary(d => d.Label);
	var visible = battles.Concat(unreadable).OrderByDescending(x => x.MatchStart).ToList();
	var lastVisible = visible.LastOrDefault();
	var emptyCause = _loading || battles.Count > 0 ? EmptyCause.None : EmptyCauseOf(Directory.Exists(SettingService.Settings.ReplayFolders.ElementAtOrDefault(BattleResultService.CurrentFolder)?.Path), _reports.Count);
	var filesToLoad = BattleResultService.FilesToLoad;
	var filesLoaded = BattleResultService.FilesLoaded;
}

<div class="gl-page">
	@* The filters wait until the loading is done: inert keeps the keyboard and the pointer out of them. *@
	<div class="gl-filters" inert="@_loading">
		<BattleFilterBar Filters="_filters"
						 Filtered="filtered"
						 Scoped="scoped"
						 @bind-Clan="_clan"
						 @bind-Player="_player"
						 @bind-ClanOnly="_clanOnly"
						 @bind-Maps="_maps"
						 @bind-Results="_results"
						 CanToggleBattleStats="_canToggleBattleStats"
						 @bind-ShowBattleStats="_showBattleStats" />
	</div>

	@if (_loading)
	{
		<MudProgressLinear Class="wot-progress"
						   Color="Color.Primary"
						   Size="Size.Small"
						   Indeterminate="@(filesToLoad == 0)"
						   Min="0"
						   Max="@Math.Max(filesToLoad, 1)"
						   Value="filesLoaded"
						   aria-label="@(filesToLoad == 0 ? "Gevechten laden" : $"Gevechten laden: {filesLoaded} van {filesToLoad} bestanden")" />
	}

	@if (emptyCause == EmptyCause.ReplayFolderMissing)
	{
		<div class="gl-empty-well">
			<EmptyState Icon="@Icons.Material.Outlined.FolderOff"
						Title="Replaymap niet gevonden"
						Text="Zonder map kan Gevechtslog geen .wotreplay-bestanden lezen. Kies de map waarin World of Tanks je replays bewaart."
						ActionText="Instellingen openen"
						ActionIcon="@Icons.Material.Outlined.Settings"
						ActionPrimary="true"
						OnAction="OpenSettingsAsync" />
		</div>
	}
	else if (emptyCause == EmptyCause.NoReplays)
	{
		<div class="gl-empty-well">
			<EmptyState Icon="@Icons.Material.Outlined.History"
						Title="Geen gevechten gevonden"
						Text="Er staan geen .wotreplay-bestanden in de map. Speel een gevecht of kies een andere map."
						ActionText="Instellingen openen"
						ActionIcon="@Icons.Material.Outlined.Settings"
						OnAction="OpenSettingsAsync" />
		</div>
	}
	else if (emptyCause == EmptyCause.FiltersHideAll)
	{
		<div class="gl-empty-well">
			<EmptyState Icon="@Icons.Material.Outlined.FilterAltOff"
						Title="Geen gevechten gevonden"
						Text="@FiltersHideAllText()"
						ActionText="Filters wissen"
						ActionIcon="@Icons.Material.Outlined.FilterAltOff"
						OnAction="ClearFilters" />
		</div>
	}
	else
	{
	<MudTable T="BattleReport"
			  Items="visible"
			  GroupBy="_groupDefinition"
			  Virtualize="true"
			  ItemSize="48"
			  FixedHeader="true"
			  FixedFooter="true"
			  Height="100%"
			  Loading="@_loading"
			  Hover="true"
			  Elevation="0"
			  Class="@("wot-battle-table" + (_showBattleStats ? " stats" : "") + (_loading ? " loading" : ""))"
			  GroupHeaderClass="gl-day"
			  RowClassFunc="@RowClass"
			  OnRowClick="@(e => ToggleShowDetailsAsync(e.Item))">
		@* 5 lead columns, 4 stat columns, 2 tail columns; the colspans in BattleRow, BattleGroupHeader and the footer follow this *@
		<ColGroup>
			<col class="c-chev" />
			<col class="c-num" />
			<col class="c-time" />
			<col class="c-map" />
			<col />
			@if (_showBattleStats)
			{
				<col class="c-stat" /><col class="c-stat" /><col class="c-stat" /><col class="c-stat c-block" />
			}
			<col class="c-res" />
			<col class="c-copy" />
		</ColGroup>
		<HeaderContent>
			<MudTh>
				<button type="button" class="gl-ibtn" aria-label="Alles inklappen" title="Alles inklappen" @onclick="CollapseAllBattleReports">
					<svg viewBox="0 0 24 24" aria-hidden="true">@((MarkupString)Icons.Material.Outlined.UnfoldLess)</svg>
				</button>
			</MudTh>
			<MudTh Class="c">#</MudTh>
			<MudTh><span class="gl-sorted">Tijd · Duur<svg viewBox="0 0 24 24" aria-hidden="true">@((MarkupString)Icons.Material.Filled.ArrowDownward)</svg></span></MudTh>
			<MudTh Class="mapcol"><div class="mapc"><span>Map</span><span></span></div></MudTh>
			<MudTh>Teams</MudTh>
			@if (_showBattleStats)
			{
				<MudTh Class="r">Geschoten</MudTh>
				<MudTh Class="r">Geraakt</MudTh>
				<MudTh Class="r">Gepenetreerd</MudTh>
				<MudTh Class="r">Geblokt</MudTh>
			}
			<MudTh Class="res">Resultaat</MudTh>
			<MudTh aria-label="Kopiëren"></MudTh>
		</HeaderContent>
		<GroupHeaderTemplate>
			@{
				var day = dayByLabel[context.Key?.ToString() ?? string.Empty];
			}
			<BattleGroupHeader Label="@day.Label"
							   Date="day.Date"
							   Reports="day.Items"
							   ShowBattleStats="_showBattleStats"
							   Stats="StatCells"
							   OnCopy="@(reports => CopyResultAsync(reports))" />
		</GroupHeaderTemplate>
		<RowTemplate>
			@if (context.Error != null)
			{
				@* One warning Alert over all the columns, instead of a silent gap. *@
				<MudTd colspan="@(_showBattleStats ? 11 : 7)" Class="gl-err">
					<MudAlert Severity="Severity.Warning" Variant="Variant.Text" Icon="@Icons.Material.Filled.Warning" Class="wot-row-alert" Dense="true" Square="true" Elevation="0">
						<b>Niet te lezen · </b>@context.Error
					</MudAlert>
				</MudTd>
			}
			else
			{
				<BattleRow Report="context"
						   Number="dayByLabel[context.Group].Number(context)"
						   ShowBattleStats="_showBattleStats"
						   Stats="StatCells"
						   OnCopy="@(report => CopyResultAsync(report, report.OwnTeam))" />
			}
		</RowTemplate>
		<ChildRowContent>
			@if (context.ShowDetails)
			{
				<BattleRow Report="context" ShowBattleStats="_showBattleStats" DetailsRow="true" />
			}
			@if (_loading && ReferenceEquals(context, lastVisible))
			{
				@* Rows still to come, under the last one. *@
				@SkeletonRow
			}
		</ChildRowContent>
		@* Loading with no row yet: the skeleton rows are real rows of the table. NoRecordsContent would sit in a th with colspan 1000, which makes the fixed layout a 1000-column table and collapses the Team column. *@
		<LoadingContentBody>
			@SkeletonRow
		</LoadingContentBody>
		<FooterContent>
			<MudTh colspan="5" scope="row">
				<div class="gl">
					<MudText Typo="Typo.h6" HtmlTag="h2">Totaal</MudText>
					@if (_loading)
					{
						<MudText Typo="Typo.caption" Class="mud-text-secondary">@filesLoaded van @filesToLoad bestanden gelezen</MudText>
					}
					<BattleTotals Reports="filtered" />
					@if (_loading && SettingService.Settings.UpdateScreeenWhileLoading)
					{
						<MudText Typo="Typo.caption" Class="mud-text-secondary">wordt bijgewerkt tijdens het laden</MudText>
					}
				</div>
			</MudTh>
			@if (_showBattleStats)
			{
				@StatCells(filtered)
			}
			<MudTd Class="res">
				@if (!_showBattleStats)
				{
					<BattleRecord Reports="filtered" ShowIcons="true" />
				}
			</MudTd>
			<MudTd></MudTd>
		</FooterContent>
	</MudTable>
	}
</div>

@code {
	[CascadingParameter]
	public required Task<AuthenticationState> AuthenticationState { get; set; }

	private bool _loading = true;
	private bool _loadedOnce;
	private HashSet<string?> _addedFiles = [];
	private BattleFilters? _filters;
	private int _battlesVersion;
	private string? _clan;
	private string? _player;
	private bool _clanOnly = true;
	private HashSet<string> _maps = [];
	private HashSet<Result> _results = [];

	private bool _canToggleBattleStats = false;
	private bool _showBattleStats = false;

	private IDialogReference? _clanMatchDialog;

	private List<BattleReport> _reports = new List<BattleReport>();
	private TableGroupDefinition<BattleReport> _groupDefinition = new()
	{
		Indentation = false,
		Expandable = false,
		Selector = (e) => e.Group
	};

	private string RowClass(BattleReport report, int index) => report.Error != null ? "gl-unreadable" : "gl-row"
		+ (index % 2 == 1 ? " alt" : string.Empty)
		+ (report.ShowDetails ? " wot-row-active" : string.Empty)
		+ (_addedFiles.Contains(report.FileName) ? " gl-new" : string.Empty);

	/// <summary>Why the table area has no rows: the cause picks the empty state.</summary>
	private enum EmptyCause
	{
		None,
		ReplayFolderMissing,
		NoReplays,
		FiltersHideAll
	}

	/// <summary>The unreadable replays that get a warning row: only when a battle row is shown and no clan or player filter is active.</summary>
	private static List<BattleReport> UnreadableShown(int battleRows, bool noFilter, IEnumerable<BattleReport> reports) =>
		battleRows > 0 && noFilter ? reports.Where(x => x.Error != null).ToList() : [];

	/// <summary>The cause of an empty table once loading is done and no battle row is shown: no folder, no replay at all in the folder (readable or not), or replays that the filters hide.</summary>
	private static EmptyCause EmptyCauseOf(bool folderExists, int replayCount) =>
		!folderExists ? EmptyCause.ReplayFolderMissing
		: replayCount == 0 ? EmptyCause.NoReplays
		: EmptyCause.FiltersHideAll;

	/// <summary>One day of battles, newest first. The number of a battle in its day is its place counted from the oldest (oldest = 1). Items are the readable battles; Newest also counts an unreadable replay of the day, which has a row but no number and no count.</summary>
	private sealed record Day(string Label, DateTime Date, List<BattleReport> Items, DateTime Newest)
	{
		/// <summary>The place of a battle in its day, counted from the oldest (oldest = 1). The result chips do not change it.</summary>
		public int Number(BattleReport report) => Items.Count - Items.IndexOf(report);
	}

	private static List<Day> BuildDays(IEnumerable<BattleReport> reports, IEnumerable<BattleReport>? unreadable = null) => reports
		.Concat(unreadable ?? [])
		.GroupBy(x => x.Group)
		.Select(x => new Day(x.Key, x.First().GroupDate, x.Where(r => r.Error == null).OrderByDescending(r => r.MatchStart).ToList(), x.Max(r => r.MatchStart)))
		.OrderByDescending(x => x.Newest)
		.ToList();

	/// <summary>The sentence of the "Geen gevechten gevonden" empty state: it names the clan, the player, the maps, the results and the switch that hide everything.</summary>
	private string FiltersHideAllText()
	{
		string search = (_clan, _player) switch
		{
			(null, null) => string.Empty,
			(string clan, null) => $" met clan {clan}",
			(null, string player) => $" met speler {player}",
			(string clan, string player) => $" met clan {clan} en speler {player}"
		};
		string maps = _maps.Count == 0 ? string.Empty : $" op {BattleFilters.MapSummary(_maps)}";
		string results = _results.Count == 0 ? string.Empty : $" met resultaat {string.Join(", ", ResultChip.Order.Where(_results.Contains).Select(ResultChip.Word))}";
		string type = _clanOnly ? " in clangevechten" : string.Empty;

		return $"Er is geen gevecht{search}{maps}{results}{type}. Probeer andere filters of wis ze.";
	}

	/// <summary>Back to the unfiltered table: no clan, no player, no map, every result. Alles and not the default Clangevechten, because a folder without clan battles would stay empty.</summary>
	private void ClearFilters()
	{
		_clan = null;
		_player = null;
		_clanOnly = false;
		_maps = [];
		_results = [];
	}

	/// <summary>Opens the settings, for the empty states that are fixed there. The dialog reloads the battles itself when the folders change.</summary>
	private async Task OpenSettingsAsync()
	{
		await DialogService.ShowAsync<SettingsDialog>("Instellingen", new DialogOptions
		{
			MaxWidth = MaxWidth.Medium,
			FullWidth = true,
			BackdropClick = false,
			CloseOnEscapeKey = true,
			CloseButton = false
		});
	}

	/// <summary>The skeleton rows: one table row with a cell per column, each as high as the table area (gl-skel-col in mud.css paints a grey bar per 48px row), so the bars line up with the columns and fill the room down to the footer.</summary>
	private RenderFragment SkeletonRow => @<text>
		<MudTr aria-busy="true">
			<MudTd Class="gl-skel-col" />
			<MudTd Class="gl-skel-col" Style="--bar: 12px; --at: 50%" />
			<MudTd Class="gl-skel-col" Style="--bar: 96px" />
			<MudTd Class="gl-skel-col" Style="--bar: 104px" />
			<MudTd Class="gl-skel-col" Style="--bar: 240px" />
			@if (_showBattleStats)
			{
				<MudTd Class="gl-skel-col" Style="--bar: 64px" />
				<MudTd Class="gl-skel-col" Style="--bar: 64px" />
				<MudTd Class="gl-skel-col" Style="--bar: 64px" />
				<MudTd Class="gl-skel-col" Style="--bar: 64px" />
			}
			<MudTd Class="gl-skel-col" Style="--bar: 76px; --at: calc(100% - 12px)" />
			<MudTd Class="gl-skel-col" />
		</MudTr>
	</text>;

	[Conditional("DEBUG")]
	private static void SelfCheck()
	{
		DateTime today = DateTime.Now.Date;
		List<BattleReport> reports = new[] { (19, 12), (19, 40), (20, 5), (20, 31), (21, 2) }
			.Select(x => new BattleReport { MatchStart = today.AddHours(x.Item1).AddMinutes(x.Item2) })
			.ToList();
		List<Day> days = BuildDays(reports);

		Debug.Assert(days.Count == 1 && days[0].Label == "Vandaag", "five battles today are one day");
		Debug.Assert(days[0].Number(reports[0]) == 1, "the 19:12 battle is #1");
		Debug.Assert(days[0].Number(reports[4]) == 5, "the newest battle is #5");
		Debug.Assert(days[0].Date == today, "the day header shows today's date");
		Debug.Assert(new BattleReport { MatchStart = today.AddHours(1) }.GroupDate == today.AddDays(-1), "a battle at 01:00 counts for the previous day");

		// The cause of an empty table picks its empty state.
		Debug.Assert(EmptyCauseOf(false, 0) == EmptyCause.ReplayFolderMissing, "no folder is the missing-folder state, whatever else is true");
		Debug.Assert(EmptyCauseOf(false, 7) == EmptyCause.ReplayFolderMissing, "no folder wins over the replay count");
		Debug.Assert(EmptyCauseOf(true, 0) == EmptyCause.NoReplays, "a folder without replays is the no-replays state");
		Debug.Assert(EmptyCauseOf(true, 7) == EmptyCause.FiltersHideAll, "replays that no row shows are hidden by the filters");

		// An unreadable replay is a row of its own: it has its day but no count and no number.
		BattleReport broken = new() { FileName = "kapot.wotreplay", MatchStart = today.AddHours(20), Error = BattleReportService.UnreadableMessage("kapot.wotreplay") };
		List<Day> brokenDays = BuildDays([], [broken]);
		Debug.Assert(broken.Error == "Kan bestand kapot.wotreplay niet lezen", "the warning row names the file");
		Debug.Assert(brokenDays.Count == 1 && brokenDays[0].Items.Count == 0 && brokenDays[0].Newest == broken.MatchStart, "an unreadable replay alone is a day with a row and no battles");
		Debug.Assert(UnreadableShown(0, true, [broken]).Count == 0, "no battle row: the unreadable replay gets no lone warning row (the empty state shows)");
		Debug.Assert(UnreadableShown(3, true, [broken]).Count == 1, "next to battle rows it gets its warning row");
		Debug.Assert(UnreadableShown(3, false, [broken]).Count == 0, "a clan or player filter hides it");
		List<Day> mixedDays = BuildDays(reports, [broken]);
		Debug.Assert(mixedDays.Count == 1 && mixedDays[0].Items.Count == 5 && mixedDays[0].Number(reports[0]) == 1, "an unreadable replay does not change the count or the numbers of its day");

		// A clan and a player filter the rows: both conditions, a player on either team.
		BattleReport Fight(string own, string other, string? ownPlayer, string? otherPlayer)
		{
			BattleReport report = new() { MatchStart = today };
			report.Team1 = new Team { Abbreviation = own };
			report.Team2 = new Team { Abbreviation = other };
			report.Team1.Players = ownPlayer == null ? [] : [new Player(report.Team1) { Name = ownPlayer }];
			report.Team2.Players = otherPlayer == null ? [] : [new Player(report.Team2) { Name = otherPlayer }];
			return report;
		}

		List<BattleReport> fights = [.. Enumerable.Range(0, 3).Select(_ => Fight("NED-1", "DUTCH", "Tankgeneraal", "KlompKees")), .. Enumerable.Range(0, 3).Select(_ => Fight("NED-1", "RHINE", null, null)), .. Enumerable.Range(0, 2).Select(_ => Fight("NED-1", "ZULU", null, null))];
		Debug.Assert(fights.Count(x => Matches(x, null, null)) == 8, "no clan and no player: 8 battles");
		Debug.Assert(fights.Count(x => Matches(x, "DUTCH", null)) == 3, "clan DUTCH: 3 battles");
		Debug.Assert(fights.Count(x => Matches(x, "dutch", "klompkees")) == 3, "clan DUTCH and player KlompKees: 3 battles, case does not matter");
		Debug.Assert(fights.Count(x => Matches(x, "RHINE", "KlompKees")) == 0, "clan RHINE and player KlompKees: 0 battles");
		Debug.Assert(fights.Count(x => Matches(x, "NED-1", null)) == 8, "your own clan is on either team");
		Debug.Assert(StatPlayers(fights, "Tankgeneraal").Count() == 3 && StatPlayers(fights, null).Count() == 0, "stats of a chosen player: only that player; no own team: nobody");
		fights[0].OwnTeam = fights[0].Team1;
		Debug.Assert(StatPlayers(fights, null).Single().Name == "Tankgeneraal" && StatPlayers(fights, "KlompKees").Count() == 3, "stats without a player: the own team; with a player: that player, on either team");

		// The Clangevechten | Alles switch, the map and the result together: 8 clan battles (6 won, 2 lost; 2 on Prokhorovka, both won) and 2 random battles (Onbekend).
		BattleReport Battle(string? map, Result result, string? own, string? other) => new() { MatchStart = today, MapName = map, Result = result, Team1 = new Team { Abbreviation = own }, Team2 = new Team { Abbreviation = other } };
		List<BattleReport> ten =
		[
			Battle("Prokhorovka", Result.Win, "NED-1", "DUTCH"), Battle("Prokhorovka", Result.Win, "NED-1", "DUTCH"),
			.. Enumerable.Range(0, 4).Select(_ => Battle("Himmelsdorf", Result.Win, "NED-1", "RHINE")),
			.. Enumerable.Range(0, 2).Select(_ => Battle("Steppes", Result.Lose, "NED-1", "ZULU")),
			Battle("Malinovka", Result.Unknown, "?", "?"), Battle(null, Result.Unknown, null, null)
		];
		int Rows(bool clanOnly, string? map, Result? result)
		{
			HashSet<string> maps = map is null ? [] : [map];
			HashSet<Result> results = result is null ? [] : [result.Value];
			return ten.Where(x => InScope(x, clanOnly, null, null)).Where(x => OnMaps(x, maps)).Count(x => ShownResult(x, results));
		}
		Debug.Assert(Rows(true, null, null) == 8, "Clangevechten: the 8 clan battles");
		Debug.Assert(Rows(false, null, null) == 10, "Alles: all 10");
		Debug.Assert(Rows(false, null, Result.Unknown) == 2, "Alles and Onbekend: the 2 random battles");
		Debug.Assert(Rows(true, "Prokhorovka", null) == 2, "Clangevechten and Prokhorovka: 2");
		Debug.Assert(Rows(true, "Prokhorovka", Result.Lose) == 0, "Clangevechten, Prokhorovka and Verloren: 0");
		Debug.Assert(ten.Where(x => InScope(x, true, null, null)).Count() == 8 && Rows(true, null, Result.Win) == 6, "Resultaat only hides rows: the scoped battles (the totals) stay 8 while 6 rows show");

		BattleTotals.SelfCheck();
		BattleFilters.SelfCheck();
		BattleStats.SelfCheck();
		ReplayReader.SelfCheck();

		// isTeamKiller is a JSON boolean; the results array is read at elements 0 and 1, the rest is skipped.
		ReplayHeader header = new() { DateTime = "08.12.2023 22:50:00", MapDisplayName = "Lakeville" };
		byte[] resultsJson = """
			[{"common":{"winnerTeam":1,"teamHealth":{"1":100,"2":0}},"vehicles":{"1":[{"xp":300,"isTeamKiller":true}],"2":[{"xp":200,"isTeamKiller":false}]}},
			 {"1":{"name":"Dader","team":1},"2":{"name":"Slachtoffer","team":1}},
			 {"1":[{"x":1}]}]
			"""u8.ToArray();
		ReplayResults? results = System.Text.Json.JsonSerializer.Deserialize(resultsJson, ReplayJsonContext.Default.ReplayResults);
		BattleReport mapped = BattleReportMapper.Map(header, results, null);
		Debug.Assert(mapped.Team1.Players.Count == 2 && mapped.Team1.Players.Single(x => x.Name == "Dader").IsTeamKiller == true, "isTeamKiller: true maps to IsTeamKiller == true");
		Debug.Assert(mapped.Team1.Players.Single(x => x.Name == "Slachtoffer").IsTeamKiller == false && mapped.Team1.Health == 100 && mapped.Team1.IsWinner == true, "isTeamKiller: false stays false, and the other results fields are read");

		// 13 against 15: team 1 gets two filler rows, each its own player, numbered 14 and 15 (they earned nothing, so they sort last).
		string Slots(int count, int firstId) => string.Join(",", Enumerable.Range(firstId, count).Select(x => $"\"{x}\":[{{\"xp\":{100 + x}}}]"));
		string Named(int team, int count, int firstId) => string.Join(",", Enumerable.Range(firstId, count).Select(x => $"\"{x}\":{{\"name\":\"P{x}\",\"team\":{team}}}"));
		byte[] uneven = System.Text.Encoding.UTF8.GetBytes($"[{{\"vehicles\":{{{Slots(13, 1)},{Slots(15, 14)}}}}},{{{Named(1, 13, 1)},{Named(2, 15, 14)}}}]");
		BattleReport thirteen = BattleReportMapper.Map(header, System.Text.Json.JsonSerializer.Deserialize(uneven, ReplayJsonContext.Default.ReplayResults), null);
		List<Player> fillers = thirteen.Team1.Players.Where(x => x.Name == null).ToList();
		Debug.Assert(thirteen.Team1.Players.Count == 15 && thirteen.Team2.Players.Count == 15 && fillers.Count == 2 && fillers[0] != fillers[1], "13 against 15: team 1 gets two separate filler players");
		Debug.Assert(fillers.Select(x => x.Number).Order().SequenceEqual([14, 15]) && thirteen.Team1.Players.Select(x => x.Number).Order().SequenceEqual(Enumerable.Range(1, 15)), "the filler rows are numbered 14 and 15, every row has its own number");
	}

	/// <summary>The players whose figures the stat columns total: the own team's players, or the chosen player on either team.</summary>
	private static IEnumerable<Player> StatPlayers(IEnumerable<BattleReport> reports, string? player) => player is null
		? reports.SelectMany(x => x.OwnTeam?.Players ?? [])
		: reports.SelectMany(x => x.Team1.Players.Concat(x.Team2.Players)).Where(x => string.Equals(x.Name, player, StringComparison.OrdinalIgnoreCase));

	/// <summary>The stat columns of stats mode for a set of battles: the total of the own team's players (or of the chosen player).</summary>
	private RenderFragment<IEnumerable<BattleReport>> StatCells => reports => @<text>
		@{
			var stats = BattleStats.Of(StatPlayers(reports, _player).ToList());
		}
		<MudTd Class="s"><RatioCell Count="@stats.Shots.ToString()" Detail="@($"{stats.ShotsPerMinute.ToString("0.0", BattleReport.DutchCulture)} p/m")" /></MudTd>
		<MudTd Class="s"><RatioCell Count="@stats.Hits.ToString()" Ratio="stats.HitRatio" Level="stats.HitRatio.GetHitLevel()" /></MudTd>
		<MudTd Class="s"><RatioCell Count="@stats.Pens.ToString()" Ratio="stats.PenRatio" Level="stats.PenRatio.GetPenLevel()" /></MudTd>
		<MudTd Class="s"><RatioCell Count="@($"{stats.Blocked} / {stats.Received}")" Ratio="stats.BlockRatio" Level="stats.BlockRatio.GetBlockLevel()" /></MudTd>
	</text>;

	protected override async Task OnInitializedAsync()
	{
		SelfCheck();

		long timestamp = 0;

		AuthenticationState authResult = await AuthenticationState;
		_canToggleBattleStats = authResult.User.HasClaim(Claims.CanSeeBattleStats, bool.TrueString);

		BattleResultService.LoadingBattleReportsStarted += async (s, e) =>
		{
			await InvokeAsync(async () =>
			{
				timestamp = Stopwatch.GetTimestamp();

				// Battles added by the file watcher: keep the table as it is, so the new rows can show up in place.
				if (_loadedOnce)
				{
					_addedFiles = [];

					return;
				}

				_reports = new List<BattleReport>();
				_battlesVersion++;
				_loading = true;
				App.SetTitle(null);
				StateHasChanged();

				// The progress bar moves with it, so it runs for every load, not only when the battles show while loading.
				while (_loading)
				{
					await Task.Delay(500);
					StateHasChanged();
				}
			});
		};

		// Another folder was selected: the rows of the old one go and the new one loads (the empty state of a missing folder shows instead of the loading state).
		BattleResultService.FolderChanged += async (s, e) =>
		{
			await InvokeAsync(() =>
			{
				_reports = [];
				_addedFiles = [];
				// The filters of the old folder do not follow (the defaults of the fields).
				_clan = null;
				_player = null;
				_clanOnly = true;
				_maps = [];
				_results = [];
				_battlesVersion++;
				_loadedOnce = false;
				_loading = Directory.Exists(SettingService.Settings.ReplayFolders.ElementAtOrDefault(BattleResultService.CurrentFolder)?.Path);
				StateHasChanged();
			});
		};

		BattleResultService.BattleReportAdded += async (s, e) =>
		{
			await InvokeAsync(() =>
			{
				_reports.Add(e.Report);
				_battlesVersion++;
				_clanMatchDialog?.Close();
				if (!_loading && _loadedOnce)
				{
					_addedFiles.Add(e.Report.FileName);
				}
			});
		};

		BattleResultService.BattleReportRemoved += async (s, e) =>
		{
			await InvokeAsync(() =>
			{
				_reports.Remove(e.Report);
				_battlesVersion++;
				StateHasChanged();
			});
		};

		BattleResultService.LoadingBattleReportsFinished += async (s, e) =>
		{
			await InvokeAsync(async () =>
			{
				_reports = BattleResultService.BattleReports.Select(x => x.Value).OrderByDescending(x => x.MatchStart).ToList();
				_battlesVersion++;
				_loading = false;
				if (!_loadedOnce)
				{
					// The load time goes behind the version in the window title.
					App.SetTitle($" · geladen in {Stopwatch.GetElapsedTime(timestamp).TotalSeconds.ToString("0.0", BattleReport.DutchCulture)} s");
				}

				_loadedOnce = true;
				StateHasChanged();

				// The rows the watcher added stay quietly highlighted for 2 seconds, unless a newer batch took over.
				HashSet<string?> shown = _addedFiles;
				if (shown.Count > 0)
				{
					await Task.Delay(2000);
					if (ReferenceEquals(_addedFiles, shown))
					{
						_addedFiles = [];
						StateHasChanged();
					}
				}
			});
		};

		BattleResultService.ClanMatchStarted += async (s, e) =>
		{
			await InvokeAsync(async () =>
			{
				if (!SettingService.Settings.AutoClanLookup)
				{
					return;
				}

				await OpenClanMatchDialog(e);
			});
		};

		await Task.Run(() => BattleResultService.LoadBattleReports());

		_loading = false;
	}

	/// <summary>A clan: the battles where either team has its tag. A player: the battles with that player on either team. Both: both conditions.</summary>
	private static bool Matches(BattleReport report, string? clan, string? player) =>
		(clan is null || BattleFilters.SameTag(report.Team1.Abbreviation, clan) || BattleFilters.SameTag(report.Team2.Abbreviation, clan))
		&& (player is null || report.Team1.Players.Concat(report.Team2.Players).Any(x => string.Equals(x.Name, player, StringComparison.OrdinalIgnoreCase)));

	/// <summary>Clangevechten hides the battles where both tags are "?" (a random battle); Alles shows them too. Then the clan and the player.</summary>
	private static bool InScope(BattleReport report, bool clanOnly, string? clan, string? player)
	{
		bool normalMatch = (report.Team1.Abbreviation == null || report.Team1.Abbreviation == "?") &&
						   (report.Team2.Abbreviation == null || report.Team2.Abbreviation == "?");

		return !(clanOnly && normalMatch) && Matches(report, clan, player);
	}

	/// <summary>No map ticked shows every map.</summary>
	private static bool OnMaps(BattleReport report, HashSet<string> maps) => maps.Count == 0 || (report.MapName != null && maps.Contains(report.MapName));

	/// <summary>Nothing ticked shows every result. This only hides rows: the totals do not follow it.</summary>
	private static bool ShownResult(BattleReport report, HashSet<Result> results) => results.Count == 0 || results.Contains(report.Result);

	private void CollapseAllBattleReports()
	{
		foreach (var report in _reports)
		{
			report.ShowDetails = false;
		}
	}

	private async Task ToggleShowDetailsAsync(BattleReport? report)
	{
		// A click inside the opened details (a sort header, a team expander) bubbles up to the child row, which has no item. An unreadable replay has no details.
		if (report is null || report.Error != null)
		{
			return;
		}

		if (!report.ShowDetails && SettingService.Settings.SingleBattleResultOpenedOnly)
		{
			CollapseAllBattleReports();
		}

		report.ShowDetails = !report.ShowDetails;
		if (report.ShowDetails)
		{
			try
			{
				await JSRuntime.InvokeVoidAsync("scrollIntoView", $"Timestamp_{report.MatchStart.Ticks + report.MatchDuration.GetValueOrDefault()}_anchor");
			}
			catch (JSException)
			{
				// Scrolling is cosmetic: a missing anchor must not fail the toggle.
			}
		}
	}

	private async Task CopyResultAsync(BattleReport report, Team? team)
	{
		string text = team?.GetResult(report.MapName) ?? string.Empty;
		await Clipboard.SetTextAsync(text);
		NotifyCopied(text);
	}

	private async Task CopyFileNameAsync(BattleReport report)
	{
		if (!string.IsNullOrEmpty(report.FileName))
		{
			await Clipboard.SetTextAsync(report.FileName);
			Snackbar.Add(BattleReportService.Notice("Gekopieerd", "bestandsnaam staat op het klembord"), Severity.Success);
		}
	}

	private void NotifyCopied(string text)
	{
		if (text.Length > 0)
		{
			Snackbar.Add(BattleReportService.Notice("Gekopieerd", "opstelling staat op het klembord"), Severity.Success);
		}
	}

	private async Task CopyResultAsync(IEnumerable<BattleReport> reports)
	{
		List<string?> results = reports.Select(x => x.OwnTeam?.GetResult(x.MapName)).Reverse().ToList();
		var splitResults = results
				.Select(r => r?.Split(Environment.NewLine, StringSplitOptions.RemoveEmptyEntries) ?? [])
				.ToList();

		// A day with only an unreadable replay has no battles to copy.
		if (splitResults.Count == 0)
		{
			return;
		}

		int maxLines = splitResults.Max(lines => lines.Length);

		IEnumerable<string> outputLines = Enumerable.Range(0, maxLines)
			.Select(i =>
			{
				var lineEntries = splitResults
					.Select(lines => i < lines.Length ? lines[i] : string.Empty)
					.ToArray();

				return string.Join("\t\t", lineEntries);
			});

		string output = string.Join(Environment.NewLine, outputLines);

		await Clipboard.SetTextAsync(output);
		NotifyCopied(output);
	}

	private async Task OpenClanMatchDialog((string, string) match)
	{
		_clanMatchDialog?.Close();
		_clanMatchDialog = await DialogService.ShowAsync<ClanMatchDialog>("Clan gevecht",
			new DialogParameters<ClanMatchDialog>() { { x => x.Match, match } },
			new DialogOptions
			{
				CloseOnEscapeKey = true,
				FullWidth = true,
				MaxWidth = MaxWidth.Large
			});
	}
