@using Microsoft.AspNetCore.Components.Authorization

<MudDialog Class="wot-dialog wot-dlg-battle overflow-hidden" ContentClass="overflow-y-auto" TitleClass="wot-dialog-bar">
	<TitleContent>
		<WotDialogTitle Title="@Title" />
	</TitleContent>
	<DialogContent>
		@{
			Team first = Report.OwnTeam ?? Report.Team1;
			Team second = first == Report.Team1 ? Report.Team2 : Report.Team1;
		}
		<MudStack Spacing="3" Class="pb-3">
			<MudStack Row Justify="Justify.Center" AlignItems="AlignItems.Center" Spacing="3" Class="flex-wrap">
				@TeamCard(first)
				@if (Report.HasScore)
				{
					<span class="score" style="font-size: 32px; min-width: 96px;">@Count(first)–@Count(second)</span>
				}
				else
				{
					<MudText Typo="Typo.h6" HtmlTag="span" Class="mud-text-secondary">vs</MudText>
				}
				@TeamCard(second)
			</MudStack>
			<MudStack Row AlignItems="AlignItems.Center" Justify="Justify.Center" Spacing="3">
				<MudText Typo="Typo.body2" Class="mud-text-secondary">
					<b>@Report.MapName</b> · @Report.MatchStart.ToString("dd-MM-yyyy") · @Report.MatchStart.ToString("HH:mm")@(Report.MatchEnd is { } end ? $"–{end:HH:mm}" : null)@(Report.MatchDuration.HasValue ? " · " : null)@Report.MatchDurationDisplay
				</MudText>
				@if (_canToggleBattleStats)
				{
					<button type="button" class="gl-imgbtn gl-icon-only gl-book" style="height: 28px; width: 32px;" aria-pressed="@(_showBattleStats ? "true" : "false")" aria-label="Statistieken" title="Uitgebreide statistieken&#10;▲ hoog · ▬ gemiddeld · ▼ laag&#10;Geraakt: ≤ 50% laag, ≥ 70% hoog&#10;Gepenetreerd: ≤ 55% laag, ≥ 70% hoog&#10;Geblokt: ≥ 25% hoog" @onclick="() => _showBattleStats = !_showBattleStats">
						<img src="@(_showBattleStats ? "images/book-open.png" : "images/book-closed.png")" alt="" style="width: 22px; height: 22px;" />
					</button>
				}
			</MudStack>
		</MudStack>
		<Details Report="Report" ShowBattleStats="_showBattleStats" ExpandTeams="true" />
	</DialogContent>
	<DialogActions>
		<MudButton OnClick="() => MudDialog.Close()">Sluiten</MudButton>
	</DialogActions>
</MudDialog>

@code {
	[CascadingParameter]
	public required IMudDialogInstance MudDialog { get; set; }

	[CascadingParameter]
	public Task<AuthenticationState>? AuthenticationState { get; set; }

	[Parameter]
	public required BattleReport Report { get; set; }

	/// <summary>The clan ratings the clan match dialog already fetched (emblem, rank); null while they are missing or failed: the header then shows the tag only.</summary>
	[Parameter]
	public IReadOnlyDictionary<string, ClanRating>? Clans { get; set; }

	// Like ClanMatchDialog's ClanCard (the card is the link to the clan page); the clan name, emblem and rank come from Clans when it is there.
	private RenderFragment TeamCard(Team team) => @<a href="@team.ClanUrl" target="_blank" rel="noopener" title="@(team.ClanUrl is null ? null : "Open de clanpagina")" class="d-block wot-clan-card" style="min-width: 280px; flex: 1 1 280px; max-width: 460px; color: inherit; text-decoration: none;">
		<MudPaper Outlined Elevation="0" Class="pa-3">
			@{
				ClanRating? clan = team.Abbreviation is { } tag && Clans is not null && Clans.TryGetValue(tag, out ClanRating? found) ? found : null;
			}
			<MudStack Row AlignItems="AlignItems.Center" Spacing="3">
				@if (clan?.EmblemUrl is { } emblem)
				{
					<img src="@emblem" alt="" width="40" height="40" />
				}
				<MudStack Spacing="0" Style="min-width: 0; flex: 1">
					<MudText Typo="Typo.h6">[@(team.Abbreviation ?? "?")]</MudText>
					<MudText Typo="Typo.body2" Class="mud-text-secondary" Style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
						@(clan is not null ? clan.Name + " · " : null)@(team == Report.OwnTeam ? "jouw clan" : "tegenstander")
					</MudText>
				</MudStack>
				<MudStack Spacing="1" AlignItems="AlignItems.End">
					<span class="wot-chip-flush"><ResultChip Result="team.Result" /></span>
					@if (clan?.Rank is { } rank)
					{
						<MudText Typo="Typo.caption" Class="mud-text-secondary">Rang @rank</MudText>
					}
				</MudStack>
			</MudStack>
		</MudPaper>
	</a>;

	private RenderFragment Count(Team team) => @<text>@if (team.Result is Result.Win) { <b>@Report.Destroyed(team)</b> } else { <span>@Report.Destroyed(team)</span> }</text>;

	private bool _canToggleBattleStats;
	private bool _showBattleStats;

	// Map, date and score, own team first as in the clan match dialog.
	private string Title
	{
		get
		{
			Team first = Report.OwnTeam ?? Report.Team1;
			Team second = first == Report.Team1 ? Report.Team2 : Report.Team1;
			string score = Report.HasScore ? $"{Report.Destroyed(first)} – {Report.Destroyed(second)}" : "–";
			return $"{Report.MapName} · {Report.MatchTimeDisplay} · {score}";
		}
	}

	// Same claim as Index; the stats columns start off.
	protected override async Task OnInitializedAsync()
	{
		_canToggleBattleStats = AuthenticationState is not null && (await AuthenticationState).User.HasClaim(Claims.CanSeeBattleStats, bool.TrueString);
	}
}
