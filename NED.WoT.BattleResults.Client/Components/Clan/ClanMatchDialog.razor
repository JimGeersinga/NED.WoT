@implements IBrowserViewportObserver
@implements IAsyncDisposable
@inject BattleReportService BattleReportService
@inject SettingService SettingService
@inject WargamingApiClient WargamingApi
@inject IdentityService Identity
@inject IBrowserViewportService ViewportService
@inject IDialogService DialogService

<MudDialog Class="wot-dialog wot-dlg-history overflow-hidden" ContentClass="overflow-y-auto" TitleClass="wot-dialog-bar">
	<TitleContent>
		<WotDialogTitle Title="Gevechtshistorie" />
	</TitleContent>
	<DialogContent>
		@if (Match.HasValue)
		{
			<MudStack Spacing="4" Class="pt-2">
				<MudStack Row Justify="Justify.Center" AlignItems="AlignItems.Center" Spacing="3" Class="flex-wrap">
					@ClanCardOf(Sides.Left, false)
					<MudText Typo="Typo.h6" HtmlTag="span" Class="mud-text-secondary">vs</MudText>
					@ClanCardOf(Sides.Right, true)
				</MudStack>
				@if (_state is RatingState.Failed)
				{
					<MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true">
						<MudStack Row AlignItems="AlignItems.Center" Spacing="3">
							<span><b>Ratings niet beschikbaar</b> · Wargaming gaf geen antwoord. Het gevecht zelf werkt gewoon.</span>
							<MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning" OnClick="LoadRatings">Opnieuw</MudButton>
						</MudStack>
					</MudAlert>
				}
				else
				{
					<MudText Typo="Typo.caption" Class="mud-text-secondary" Align="Align.Center">
						@(_state is RatingState.Loading ? "Ratings ophalen bij Wargaming…" : $"Ratings uit de Wargaming API · bijgewerkt {_updated:HH:mm} · PR = persoonlijke rating · WTR = World of Tanks Rating")
					</MudText>
				}

				<MudStack Row Justify="Justify.Center" Spacing="6" role="group" aria-label="Eerdere gevechten">
					@foreach (var (result, count) in new[] { (Result.Win, _battles.Count(x => x.Result is Result.Win)), (Result.Draw, _battles.Count(x => x.Result is Result.Draw)), (Result.Lose, _battles.Count(x => x.Result is Result.Lose)) })
					{
						<MudStack Row AlignItems="AlignItems.Center" Spacing="2">
							<MudText Typo="Typo.h5">@count</MudText>
							<ResultChip Result="result" />
						</MudStack>
					}
				</MudStack>

				@if (_narrow)
				{
					<MudTabs Class="wot-tabs" Elevation="0" TabPanelsClass="pt-4">
						<MudTabPanel Text="@OpponentsTitle">@Opponents</MudTabPanel>
						<MudTabPanel Text="@PastTitle">@if (_selected.Count > 0) { @PastHeading }@Past</MudTabPanel>
					</MudTabs>
				}
				else
				{
					<MudGrid Spacing="4">
						<MudItem xs="6">
							<MudPaper Outlined Elevation="0" Class="overflow-hidden">
								<MudText Typo="Typo.h6" Class="px-4 py-3">@OpponentsTitle</MudText>
								@Opponents
							</MudPaper>
						</MudItem>
						<MudItem xs="6">
							<MudPaper Outlined Elevation="0" Class="overflow-hidden">
								@PastHeading
								@Past
							</MudPaper>
						</MudItem>
					</MudGrid>
				}
			</MudStack>
		}
	</DialogContent>
	<DialogActions>
		<MudButton OnClick="Cancel">Sluiten</MudButton>
	</DialogActions>
</MudDialog>

@code {
	private string OpponentsTitle => $"Tegenstanders · {_enemyPlayers.Count}";
	private string PastTitle => $"Eerdere gevechten · {_battles.Count}";

	private RenderFragment PastHeading => @<MudStack Row AlignItems="AlignItems.Center" Spacing="3" Class="px-4 py-3">
		<MudText Typo="Typo.h6">@PastTitle@(_selected.Count > 0 ? $" · {_selected.Count} geselecteerd" : null)</MudText>
		@if (_selected.Count > 0)
		{
			<MudButton Size="Size.Small" Variant="Variant.Text" OnClick="ClearSelection">Wis selectie</MudButton>
		}
	</MudStack>;

	private RenderFragment Opponents => @<OpponentsTable Items="_enemyPlayers" Loading="_state is RatingState.Loading" Players="@(_state is RatingState.Ok ? _players : null)" />;

	private RenderFragment Past => @<PastBattlesTable Items="_battles" Selected="_selected" OnToggle="Toggle" OnToggleMonth="ToggleMonth" OnOpen="OpenBattle" />;

	// The clan page: the id from the rating lookup, else the id the battles carry for that tag; no link when neither is known.
	private string? ClanPageUrl(string tag) =>
		_clans.TryGetValue(tag, out ClanRating? clan) && Team.UrlOf(clan.ClanId) is { } url
			? url
			: _battles.SelectMany(x => new[] { x.Team1, x.Team2 }).FirstOrDefault(x => x.ClanUrl is not null && string.Equals(x.Abbreviation, tag, StringComparison.OrdinalIgnoreCase))?.ClanUrl;

	private ClanRating? ClanOf(string tag) => _clans.TryGetValue(tag, out ClanRating? clan) ? clan : null;

	// mirror = the right card: its emblem is on the outer edge and the rating towards the "vs".
	private RenderFragment ClanCardOf(string tag, bool mirror) => @<ClanCard Tag="@tag" ClanUrl="@ClanPageUrl(tag)" Name="@ClanOf(tag)?.Name" EmblemUrl="@ClanOf(tag)?.EmblemUrl" Mirror="@mirror" Aside="@RatingAside(tag, mirror)" />;

	private RenderFragment RatingAside(string tag, bool mirror) => @<text>
		<MudText Typo="Typo.overline" Class="mud-text-secondary">Clanrating</MudText>
		@if (_state is RatingState.Loading)
		{
			<MudSkeleton Width="64px" Height="33px" Class="@(mirror ? "mr-auto" : "ml-auto")" />
		}
		else if (_state is RatingState.Ok && ClanOf(tag) is { Rating: { } value } rated)
		{
			<MudText Class="wot-rating-value">@NumberFormat.Fmt(value)</MudText>
			@if (rated.Rank is { } rank)
			{
				<MudText Typo="Typo.caption" Class="mud-text-secondary">Rang @rank</MudText>
			}
		}
		else
		{
			<MudText Class="mud-text-secondary wot-rating-value">–</MudText>
		}
	</text>;

	[CascadingParameter]
	public required IMudDialogInstance MudDialog { get; set; }

	[Parameter]
	public (string, string)? Match { get; set; }

	private enum RatingState { Loading, Ok, Failed }

	private RatingState _state = RatingState.Loading;
	private DateTime _updated;
	private Dictionary<string, PlayerRating> _players = new(StringComparer.OrdinalIgnoreCase);
	private Dictionary<string, ClanRating> _clans = new(StringComparer.OrdinalIgnoreCase);
	private CancellationTokenSource _cts = new();

	private string? OwnTag => Identity.Current?.ClanTag;

	// The signed-in clan is always on the left; no own clan (or neither side matches) keeps the game's order. Display only: the battle filter still uses Match.
	private (string Left, string Right) Sides => Match is { } m && OwnTag is not null && m.Item2.Equals(OwnTag, StringComparison.OrdinalIgnoreCase) ? (m.Item2, m.Item1) : Match ?? default;

	private List<BattleReport> _battles = [];
	private List<IGrouping<string?, Player>> _enemyPlayers = [];
	private string[] _allOpponentNames = [];
	private readonly HashSet<string> _selected = new(StringComparer.Ordinal); // BattleReport.FileName of the selected battles (union filter)

	private bool IsSelected(BattleReport x) => _selected.Contains(PastBattlesTable.KeyOf(x));

	private void Toggle(BattleReport x)
	{
		if (!_selected.Remove(PastBattlesTable.KeyOf(x)))
		{
			_selected.Add(PastBattlesTable.KeyOf(x));
		}

		BuildOpponents();
	}

	private void ToggleMonth(IReadOnlyList<string> keys)
	{
		if (keys.All(_selected.Contains))
		{
			_selected.ExceptWith(keys);
		}
		else
		{
			_selected.UnionWith(keys);
		}

		BuildOpponents();
	}

	private void ClearSelection()
	{
		_selected.Clear();
		BuildOpponents();
	}

	// No selection = all battles. Ratings are not touched: they were fetched once for _allOpponentNames.
	private void BuildOpponents() => _enemyPlayers = OpponentsOf(_selected.Count == 0 ? _battles : _battles.Where(IsSelected));

	private static List<IGrouping<string?, Player>> OpponentsOf(IEnumerable<BattleReport> battles) => battles
		.Select(x => x.OwnTeam == x.Team1 ? x.Team2 : x.Team1)
		.SelectMany(x => x.Players)
		.GroupBy(x => x.Name)
		.OrderByDescending(x => x.Count())
		.ToList();

	protected override void OnParametersSet()
	{
		if (Match is not null)
		{
			_battles = BattleReportService.BattleReports
				.Where(x =>
					(x.Value.Team1.Abbreviation?.Equals(Match.Value.Item1, StringComparison.OrdinalIgnoreCase) ?? false) &&
					(x.Value.Team2.Abbreviation?.Equals(Match.Value.Item2, StringComparison.OrdinalIgnoreCase) ?? false)
					||
					(x.Value.Team1.Abbreviation?.Equals(Match.Value.Item2, StringComparison.OrdinalIgnoreCase) ?? false) &&
					(x.Value.Team2.Abbreviation?.Equals(Match.Value.Item1, StringComparison.OrdinalIgnoreCase) ?? false)
				)
				.Select(x => x.Value)
				.ToList();

			_allOpponentNames = OpponentsOf(_battles).Where(x => x.Key is not null).Select(x => x.Key!).ToArray();
			BuildOpponents();
		}
	}

	private async Task LoadRatings()
	{
		await _cts.CancelAsync();
		_cts.Dispose();
		_cts = new CancellationTokenSource();
		CancellationToken ct = _cts.Token;
		_state = RatingState.Loading;
		StateHasChanged();
		try
		{
			string[] tags = [Match!.Value.Item1, Match.Value.Item2];
			string[] names = _allOpponentNames;
			Task<ClanRatingResult>[] clanTasks = tags.Select(t => WargamingApi.GetClanRatingAsync(t, ct)).ToArray();
			RatingsResult players = await WargamingApi.GetPlayerRatingsAsync(names, ct);
			ClanRatingResult[] clans = await Task.WhenAll(clanTasks);
			if (ct.IsCancellationRequested)
			{
				return;
			}

			if (players.Ok && clans.All(x => x.Ok))
			{
				_players = players.Players.ToDictionary(x => x.Nickname, StringComparer.OrdinalIgnoreCase);
				_clans = clans.Select(x => x.Clan).OfType<ClanRating>().ToDictionary(x => x.Tag, StringComparer.OrdinalIgnoreCase);
				_updated = DateTime.Now;
				_state = RatingState.Ok;
			}
			else
			{
				_state = RatingState.Failed;
			}
		}
		catch (OperationCanceledException)
		{
			return; // a newer load (Opnieuw) or the dialog closing took over
		}
		catch (Exception)
		{
			_state = RatingState.Failed; // never leave the skeleton hanging
		}

		await InvokeAsync(StateHasChanged);
	}

	// Stacked on top of this dialog; Esc closes only the top one.
	private Task OpenBattle(BattleReport report) => DialogService.ShowAsync<BattleDetailsDialog>(string.Empty,
		new DialogParameters<BattleDetailsDialog> { { x => x.Report, report }, { x => x.Clans, _state is RatingState.Ok ? _clans : null } },
		new DialogOptions { CloseButton = true, CloseOnEscapeKey = true, MaxWidth = MaxWidth.False });

	void Cancel() => MudDialog.Close(DialogResult.Ok(true));

	// Below 1100px wide the two tables become tabs (docs/DESIGN.md, ".wot-tabs"); MudBlazor's own breakpoints (960, 1280) do not fall there.
	private const int TabsBelowWidth = 1100;
	private bool _narrow;

	Guid IBrowserViewportObserver.Id { get; } = Guid.NewGuid();

	MudBlazor.Services.ResizeOptions? IBrowserViewportObserver.ResizeOptions { get; } = new() { NotifyOnBreakpointOnly = false };

	Task IBrowserViewportObserver.NotifyBrowserViewportChangeAsync(BrowserViewportEventArgs e)
	{
		bool narrow = e.BrowserWindowSize.Width < TabsBelowWidth;
		if (narrow == _narrow)
		{
			return Task.CompletedTask;
		}

		_narrow = narrow;
		return InvokeAsync(StateHasChanged);
	}

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender)
		{
			// The dialog is already showing; the ratings arrive when Wargaming answers (never awaited here).
			if (Match.HasValue)
			{
				_ = LoadRatings();
			}

			await ViewportService.SubscribeAsync(this);
		}
	}

	public async ValueTask DisposeAsync()
	{
		await _cts.CancelAsync();
		await ViewportService.UnsubscribeAsync(this);
	}
}
