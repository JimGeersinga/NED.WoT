@* The record of a set of battles in the Resultaat column of the day header and the totals footer, with the result icons of the chips. *@
<span class="gl-rec">
    <span class="w">@Icon(Icons.Material.Filled.CheckCircle)<span class="n">@Reports.Count(x => x.Result is Result.Win)</span> gewonnen</span>
    <span class="d">@Icon(Icons.Material.Filled.RemoveCircle)<span class="n">@Reports.Count(x => x.Result is Result.Draw)</span> gelijkspel</span>
    <span class="l">@Icon(Icons.Material.Filled.Cancel)<span class="n">@Reports.Count(x => x.Result is Result.Lose)</span> verloren</span>
    <span>@Icon(Icons.Material.Filled.HelpOutline)<span class="n">@Reports.Count(x => x.Result is Result.Unknown)</span> onbekend</span>
</span>

@code {
    [Parameter, EditorRequired]
    public required IReadOnlyCollection<BattleReport> Reports { get; set; }

    /// <summary>The result icon in front of each count (the day header and the footer).</summary>
    [Parameter]
    public bool ShowIcons { get; set; }

    private RenderFragment Icon(string path) => ShowIcons
        ? @<svg viewBox="0 0 24 24" aria-hidden="true">@((MarkupString)path)</svg>
        : @<text></text>;
}
